# DEPRECATED compatibility input for the exact `legacy-acceptance` profile and
# `llm-bin-patch-legacy` service. Do not use this as the standard ACP setup.
ACP_HARNESS=legacy-openai
# Public routing URL only: no user-info, query, fragment, or credentials in the path.
# Factory provenance hashes the effective endpoint, MODEL and REASONING_EFFORT, never API_KEY.
BASE_URL=https://api.example.com/v1
API_KEY=replace-me
MODEL=openai-compatible-model-name
REASONING_EFFORT=medium
