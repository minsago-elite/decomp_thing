        "functions": {
          "type": "integer",
          "minimum": 0
        },
        "thunks": {
          "type": "integer",
          "minimum": 0
        },
        "instructionsVisited": {
          "type": "integer",
          "minimum": 0
        },
        "ownedInstructions": {
          "type": "integer",
          "minimum": 0
        },
        "unownedInstructions": {
          "type": "integer",
          "minimum": 0
