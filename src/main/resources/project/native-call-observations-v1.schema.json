    "ExternalObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "externalSpaceAddress",
        "externalProgramAddress",
        "libraryName",
        "label",
        "originalImportedName",
        "source"
      ],
      "properties": {
        "externalSpaceAddress": {
          "$ref": "#/$defs/Address"
        },
        "externalProgramAddress": {
          "anyOf": [
            {
              "$ref": "#/$defs/Address"
            },
            {
              "type": "null"
            }
          ]
        },
        "libraryName": {
          "type": "string",
          "maxLength": 4096
        },
        "label": {
          "type": "string",
          "maxLength": 4096
        },
        "originalImportedName": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "enum": [
            "DEFAULT",
            "ANALYSIS",
            "AI",
            "IMPORTED",
            "USER_DEFINED"
          ]
        }
      }
    },
    "MemoryBlockObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "start",
        "end",
        "initialized",
        "executable"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 4096
        },
        "start": {
          "$ref": "#/$defs/Address"
        },
        "end": {
          "$ref": "#/$defs/Address"
        },
        "initialized": {
          "type": "boolean"
        },
        "executable": {
          "type": "boolean"
        }
      }
    },
    "TargetObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "functionEntry",
        "external",
        "memoryBlock"
      ],
      "properties": {
        "address": {
          "$ref": "#/$defs/Address"
        },
        "functionEntry": {
          "anyOf": [
            {
              "$ref": "#/$defs/Address"
            },
            {
              "type": "null"
            }
          ]
        },
        "external": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExternalObservation"
            },
            {
              "type": "null"
            }
          ]
        },
        "memoryBlock": {
          "anyOf": [
            {
              "$ref": "#/$defs/MemoryBlockObservation"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ReferenceObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "target",
        "operandIndex",
        "primary",
        "source",
        "referenceType"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/Address"
        },
        "target": {
          "$ref": "#/$defs/TargetObservation"
        },
        "operandIndex": {
          "type": "integer"
        },
        "primary": {
          "type": "boolean"
        },
        "source": {
          "enum": [
            "DEFAULT",
            "ANALYSIS",
            "AI",
            "IMPORTED",
            "USER_DEFINED"
          ]
        },
        "referenceType": {
          "$ref": "#/$defs/ReferenceType"
        }
      }
    },
    "ReferenceNeighborhood": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "viaReferenceIndex",
        "source",
        "references"
      ],
      "properties": {
        "viaReferenceIndex": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "$ref": "#/$defs/Address"
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReferenceObservation"
          },
          "maxItems": 64
        }
      }
    },
    "NativeCallBindingsV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collectorSha256",
        "compilerSpecId",
        "ghidraArchiveSha256",
        "imageBase",
        "inputSha256",
        "languageId",
        "programModelBytes",
        "programModelExporterSha256",
        "programModelSha256"
      ],
      "properties": {
        "collectorSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "compilerSpecId": {
          "type": "string",
          "maxLength": 4096
        },
        "ghidraArchiveSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "imageBase": {
          "$ref": "#/$defs/Address"
        },
        "inputSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "languageId": {
          "type": "string",
          "maxLength": 4096
        },
        "programModelBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912
        },
        "programModelExporterSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "programModelSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "FunctionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordKind",
        "entry",
        "bodyAddressCount",
        "bodyRangeCount",
        "isThunk",
        "immediateThunkTarget"
      ],
      "properties": {
        "recordKind": {
          "const": "function"
        },
        "entry": {
          "$ref": "#/$defs/Address"
        },
        "bodyAddressCount": {
          "type": "integer",
          "minimum": 0
        },
        "bodyRangeCount": {
          "type": "integer",
          "minimum": 0
        },
        "isThunk": {
          "type": "boolean"
        },
        "immediateThunkTarget": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetObservation"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "SiteRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordKind",
        "address",
        "owner",
        "observationKind",
        "listedLength",
        "delaySlotDepth",
        "lengthOverridden",
        "byteStatus",
        "instructionBytes",
        "prototypeFlow",
        "effectiveFlow",
        "flowOverride",
        "prototypeFallThrough",
        "effectiveFallThrough",
        "prototypeTargets",
        "references",
        "referenceNeighborhoods"
      ],
      "properties": {
        "recordKind": {
          "const": "site"
        },
        "address": {
          "$ref": "#/$defs/Address"
        },
        "owner": {
          "anyOf": [
            {
              "$ref": "#/$defs/Address"
            },
            {
              "type": "null"
            }
          ]
        },
        "observationKind": {
          "enum": [
            "prototype-call",
            "analysis-call-candidate",
            "direct-tail-candidate"
          ]
        },
        "listedLength": {
          "type": "integer",
          "minimum": 1
        },
        "delaySlotDepth": {
          "type": "integer",
          "minimum": 0
        },
        "lengthOverridden": {
          "type": "boolean"
        },
        "byteStatus": {
          "enum": [
            "available",
            "unsupported-boundary"
          ]
        },
        "instructionBytes": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 8192,
              "pattern": "^(?:[0-9a-f]{2})+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "prototypeFlow": {
          "$ref": "#/$defs/ReferenceType"
        },
        "effectiveFlow": {
          "$ref": "#/$defs/ReferenceType"
        },
        "flowOverride": {
          "enum": [
            "NONE",
            "BRANCH",
            "CALL",
            "CALL_RETURN",
            "RETURN"
          ]
        },
        "prototypeFallThrough": {
          "anyOf": [
            {
              "$ref": "#/$defs/Address"
            },
            {
              "type": "null"
            }
          ]
        },
        "effectiveFallThrough": {
          "anyOf": [
            {
              "$ref": "#/$defs/Address"
            },
            {
              "type": "null"
            }
          ]
        },
        "prototypeTargets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TargetObservation"
          },
          "maxItems": 64
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReferenceObservation"
          },
          "maxItems": 64
        },
        "referenceNeighborhoods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReferenceNeighborhood"
          },
          "maxItems": 64
        }
      }
    },
    "FunctionSummaryRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordKind",
        "entry",
        "instructionsVisited",
        "prototypeCalls",
        "analysisCallCandidates",
        "directTailCandidates",
        "ordinaryJumpInstructions",
        "unresolvedComputedJumps"
