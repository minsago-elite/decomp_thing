{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:decompengine:native-call-observations-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "addressSpaces",
    "bindings",
    "policy",
    "records",
    "schemaVersion",
    "summary"
  ],
  "properties": {
    "addressSpaces": {
      "type": "array",
