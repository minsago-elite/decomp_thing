        },
        "entry": {
          "$ref": "#/$defs/Address"
        },
        "instructionsVisited": {
          "type": "integer",
          "minimum": 0
        },
        "prototypeCalls": {
          "type": "integer",
          "minimum": 0
        },
        "analysisCallCandidates": {
          "type": "integer",
          "minimum": 0
        },
        "directTailCandidates": {
          "type": "integer",
          "minimum": 0
        },
        "ordinaryJumpInstructions": {
          "type": "integer",
          "minimum": 0
        },
        "unresolvedComputedJumps": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ScanSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage",
        "functions",
        "thunks",
        "instructionsVisited",
        "ownedInstructions",
