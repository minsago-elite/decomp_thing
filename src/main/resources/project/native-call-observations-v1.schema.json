    "bindings": {
      "$ref": "#/$defs/NativeCallBindingsV1"
    },
    "policy": {
      "const": "ghidra-native-call-observations-v1"
    },
    "records": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/FunctionRecord"
          },
          {
            "$ref": "#/$defs/SiteRecord"
          },
          {
            "$ref": "#/$defs/FunctionSummaryRecord"
          }
        ]
      },
      "maxItems": 10262144
    },
    "schemaVersion": {
      "const": 1
    },
    "summary": {
      "$ref": "#/$defs/ScanSummary"
    }
  },
  "$defs": {
    "Address": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "no-address"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "spaceIndex",
            "offsetBits"
          ],
          "properties": {
            "kind": {
              "const": "address"
            },
            "spaceIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "offsetBits": {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            }
          }
        }
      ]
    },
    "AddressSpace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "name",
        "type",
        "sizeBits",
        "addressableUnitSize",
        "overlay",
        "signedOffsets"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "name": {
          "type": "string",
          "maxLength": 4096
        },
        "type": {
          "type": "integer"
        },
        "sizeBits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "addressableUnitSize": {
          "type": "integer",
          "minimum": 1
        },
        "overlay": {
          "type": "boolean"
        },
        "signedOffsets": {
          "type": "boolean"
        }
      }
    },
    "ReferenceType": {
