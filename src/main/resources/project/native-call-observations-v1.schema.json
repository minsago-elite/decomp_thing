        "prototypeCalls",
        "analysisCallCandidates",
        "directTailCandidates",
        "ordinaryJumpInstructions",
        "unresolvedComputedJumps",
        "directReferences",
        "neighborhoodReferences",
        "unownedPrototypeCalls",
        "unownedAnalysisCallCandidates",
