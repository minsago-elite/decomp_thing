{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/minsago-elite/decomp_thing/native-interface-observation-manifest-v1.schema.json",
  "title": "Recovered native listing-interface observation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bytes",
    "collectorSha256",
    "file",
    "inputSha256",
    "kind",
    "programModelSha256",
    "schemaVersion",
    "sha256"
  ],
  "properties": {
    "bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1073741824
    },
    "collectorSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "file": {
      "const": "native-interfaces.json"
    },
    "inputSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "kind": {
      "const": "ghidra-native-interface-observation-manifest-v1"
    },
    "programModelSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "schemaVersion": {
      "const": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
