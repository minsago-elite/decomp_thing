{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/minsago-elite/decomp_thing/native-inferred-interface-observations-v1.schema.json",
  "title": "Raw inferred native interfaces and bounded type graphs (no oracle or scoring authority)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "addressSpaces",
    "bindings",
    "configuration",
    "dataOrganization",
    "policy",
    "records",
    "schemaVersion",
    "summary"
  ],
  "properties": {
    "addressSpaces": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/addressSpace"
      },
      "minItems": 1
    },
    "bindings": {
      "$ref": "#/$defs/bindings"
    },
    "configuration": {
      "$ref": "#/$defs/configuration"
    },
    "dataOrganization": {
      "$ref": "#/$defs/dataOrganization"
    },
    "policy": {
      "const": "ghidra-native-inferred-interface-observations-v1"
    },
    "records": {
      "type": "array",
      "maxItems": 4724288,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/function"
          },
          {
            "$ref": "#/$defs/root"
          },
          {
            "$ref": "#/$defs/node"
          },
          {
            "$ref": "#/$defs/edge"
          }
        ]
      }
    },
    "schemaVersion": {
      "const": 1
    },
    "summary": {
      "$ref": "#/$defs/summary"
    }
  },
  "$defs": {
    "address": {
      "oneOf": [
        {
          "$ref": "#/$defs/locatedAddress"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "no-address"
            }
          }
        }
      ]
    },
    "locatedAddress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "spaceIndex",
        "offsetBits"
      ],
      "properties": {
        "spaceIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "offsetBits": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "kind": {
          "const": "address"
        }
      }
    },
    "addressSpace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "name",
        "type",
        "sizeBits",
        "addressableUnitSize",
        "overlay",
        "signedOffsets"
