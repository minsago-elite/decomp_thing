      "properties": {
        "listingBindings": {
          "$ref": "#/$defs/listingBindings"
        },
        "collectorSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "wrapperSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "nativeDecompilerSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
