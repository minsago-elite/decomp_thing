        "languageId": {
          "type": "string",
          "maxLength": 4096
        },
        "programModelBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912
        },
        "programModelExporterSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "programModelSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "listingBindings",
        "collectorSha256",
        "wrapperSha256",
        "nativeDecompilerSha256",
        "listingBytes",
        "listingSha256",
        "listingManifestSha256",
