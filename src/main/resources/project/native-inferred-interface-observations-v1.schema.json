      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "name": {
          "type": "string",
          "maxLength": 4096
        },
        "type": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
