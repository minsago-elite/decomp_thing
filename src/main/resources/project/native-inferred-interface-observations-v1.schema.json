        "addressableUnitSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "overlay": {
          "type": "boolean"
        },
        "signedOffsets": {
          "type": "boolean"
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "size",
        "autoStorage",
        "autoParameterType",
        "forcedIndirect",
        "varnodes"
      ],
      "properties": {
        "state": {
          "enum": [
            "assigned",
            "bad",
            "unassigned",
            "void",
            "absent"
