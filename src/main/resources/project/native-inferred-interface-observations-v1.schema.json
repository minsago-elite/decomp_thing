          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "listingManifestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "configurationSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "typeGraphSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
