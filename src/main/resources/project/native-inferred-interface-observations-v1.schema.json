          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "imageBase": {
          "$ref": "#/$defs/locatedAddress"
        },
        "inputSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
