# ACP is the default harness. Keep this file private and point at the completed,
# mode-0600 copy of config/acp-v1.example.json.
ACP_CONFIG_FILE=/absolute/path/to/private-acp-v1.json

# The outer ACP namespace has no network. This root must contain the locally
# runnable native agent at bin/acp-agent and its read-only runtime/ closure.
ACP_AGENT_RUNTIME_ROOT=/opt/decomp-acp-agent
ACP_SANDBOX_GATE_HELPER_FILE=/opt/decomp-acp-host/decomp-acp-gate-helper

# The acp-host Compose profile is qualified only with this dedicated same-UID
# host user, its live user-systemd bus, and host PID/cgroup-v2 visibility.
ACP_SERVICE_UID=1000
ACP_SERVICE_GID=1000
ACP_SYSTEMD_USER_RUNTIME=/run/user/1000
