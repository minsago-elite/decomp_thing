+    private static boolean finiteOwnedFactory(Class<?> type) {
+        return type == PointerDataType.class || type == Pointer8DataType.class ||
+            type == Pointer16DataType.class || type == Pointer24DataType.class ||
+            type == Pointer32DataType.class || type == Pointer40DataType.class ||
+            type == Pointer48DataType.class || type == Pointer56DataType.class || type == Pointer64DataType.class;
+    }
+    public final DataType strictReferencedDataType(DataTypeManager destination) {
+        if (!ownedFactoryAuthority || !finiteOwnedFactory(getClass()) || deleted ||
+            (getDataTypeManager() != null && getDataTypeManager() != destination))
+            {
+            IllegalStateException failure = new IllegalStateException("Unauthoritative in-memory pointer");
+            // The checker rejects this same input and publishes to its pre-registration owner.
+            ghidra.program.database.data.DataTypeManagerDB.recordOwnedPointerFailure(destination, failure);
+            throw failure;
+        }
+        return referencedDataType;
+    }
+    public static PointerDataType copyForManager(Pointer source, DataTypeManager destination) {
+        try {
+
+        ghidra.program.database.data.DataTypeManagerDB.checkOwnedPointerCopy(source, destination);
+        if (source instanceof PointerDataType memory) {
+            return new PointerDataType(memory.referencedDataType, memory.length, destination,
+                memory.ownedFactoryAuthority && !memory.deleted &&
+                (memory.getDataTypeManager() == null || memory.getDataTypeManager() == destination));
+        }
+        return new PointerDataType(source.getDataType(),
+            source.hasLanguageDependantLength() ? -1 : source.getLength(), destination, false);
+    
+        }
+        catch (RuntimeException | Error failure) {
+            ghidra.program.database.data.DataTypeManagerDB.recordOwnedPointerFailure(destination, failure);
+            throw failure;
+        }
+    }
