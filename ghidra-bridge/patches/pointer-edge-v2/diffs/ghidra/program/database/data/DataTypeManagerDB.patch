+    }
+    final long resolveOwnedPointerChildID(DataType original, DataTypeConflictHandler handler) {
+        if (original == null) return NULL_DATATYPE_ID; // caller has already checked pointer authority
+        ownedIngress(original);
+        try {
+            DataType first = resolve(original, handler);
+            if (first == null) throw ownedFailure("First child resolution lost identity");
+            if (first instanceof DataTypeDB db && db.dataMgr != this)
+                throw ownedFailure("Foreign first child before second resolution");
+            DataType canonical = resolve(first, currentHandler);
+            if (canonical == null) throw ownedFailure("Final child resolution lost identity");
+            if (canonical instanceof DataTypeDB db && db.dataMgr != this)
+                throw ownedFailure("Foreign final child before ID lookup");
+            long id = getID(canonical);
+            requireOwnedChildIdentity(canonical, id);
+            return id;
+        }
+        catch (IOException | RuntimeException | Error e) { throw ownedFailure(e); }
+    }
+    private void validateOwnedResolved(DataType original, DataType result) {
+        if (!isOwnedStrict()) return;
+        try {
+            requireOwnedLive();
+            if (result == null) throw ownedFailure("Resolution lost original input");
+            if (result instanceof DataTypeDB db && db.dataMgr != this)
+                throw ownedFailure("Foreign resolution before ID lookup");
+            if (original instanceof Pointer && !(result instanceof PointerDB))
+                throw ownedFailure("Resolution changed pointer kind");
+            if (result instanceof PointerDB pointer) readOwnedPointerEdge(pointer, TaskMonitor.DUMMY);
+            requireOwnedChildIdentity(result, getID(result));
+        }
+        catch (IOException | CancelledException | RuntimeException | Error e) { throw ownedFailure(e); }
+    }
+    final boolean hasOwnedEmptyTypeSettings(long typeID, TaskMonitor monitor)
+            throws IOException, CancelledException {
