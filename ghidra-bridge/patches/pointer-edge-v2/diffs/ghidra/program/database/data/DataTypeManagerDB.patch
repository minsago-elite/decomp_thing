+        }
+        catch (IOException | CancelledException | RuntimeException | Error e) { ownedFailure(e); throw e; }
+    }
+    final void requireOwnedSettingRow(DBRecord row, long association) {
+        if (row == null || !row.hasSameSchema(SettingsDBAdapter.SETTINGS_SCHEMA) ||
+            row.getLongValue(SettingsDBAdapter.SETTINGS_ASSOCIATION_ID_COL) != association)
+            throw ownedFailure("Malformed settings association/schema");
+    }
