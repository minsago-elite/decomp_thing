+    private DataType ownedPointerChild(Pointer pointer) {
+        checkOwnedPointerCopy(pointer, this);
+        if (pointer instanceof PointerDataType memory) return memory.strictReferencedDataType(this);
+        try {
+            long edge = readOwnedPointerEdge((PointerDB) pointer, TaskMonitor.DUMMY);
+            return edge == NULL_DATATYPE_ID ? null : getDataType(edge);
+        }
+        catch (IOException | CancelledException e) { throw ownedFailure(e); }
+    }
