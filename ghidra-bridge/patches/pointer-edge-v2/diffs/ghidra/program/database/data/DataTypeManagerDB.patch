+    private final ProgramDB ownedProgram;
+    private volatile long ownedGeneration;
+    private volatile boolean ownedDisposed;
+
+    final boolean isOwnedStrict() { return ownedProgram != null; }
+    final ProgramDB ownedProgram() { return ownedProgram; }
+    final long ownedGeneration() { return ownedGeneration; }
+    final ghidra.framework.data.OwnedProgramIntegrityException ownedFailure(Throwable cause) {
+        if (ownedProgram == null) throw new IllegalStateException("Not an owned manager", cause);
+        return ownedProgram.recordOwnedIntegrityFailure(cause);
+    }
+    final ghidra.framework.data.OwnedProgramIntegrityException ownedFailure(String reason) {
+        return ownedFailure(new IllegalStateException(reason));
+    }
+    final void requireOwnedLive() {
+        if (ownedProgram == null) throw new java.lang.UnsupportedOperationException("Unowned manager");
+        ownedProgram.checkOwnedIntegrity();
+        if (ownedDisposed || ownedProgram.isClosed()) throw ownedFailure("Disposed owned manager");
+    }
+    final void checkOwnedCancellation(TaskMonitor monitor) throws CancelledException {
+        try {
+            if (monitor == null) throw new IllegalArgumentException("Missing monitor");
+            if (Thread.currentThread().isInterrupted()) throw new CancelledException();
+            monitor.checkCancelled();
+            if (Thread.currentThread().isInterrupted()) throw new CancelledException();
+        }
+        catch (CancelledException | RuntimeException | Error e) { ownedFailure(e); throw e; }
+    }
+    final void acquireOwned(TaskMonitor monitor) throws CancelledException {
+        requireOwnedLive();
+        checkOwnedCancellation(monitor);
+        synchronized (lock) {
+            if (lock.getOwner() != null && lock.getOwner() != Thread.currentThread())
+                throw ownedFailure("Owned lock contention");
+            lock.acquire();
+        }
+        try { checkOwnedCancellation(monitor); }
+        catch (CancelledException | RuntimeException | Error e) {
+            releaseOwnedLock(e);
+            throw e;
+        }
+    }
+    // Negative-only cleanup: retain the first failure and suppress a later release failure.
+    final void releaseOwnedLock(Throwable primary) {
+        try { lock.release(); }
+        catch (RuntimeException | Error failure) {
+            if (isOwnedStrict()) ownedFailure(failure);
+            if (isOwnedStrict() && primary != null) {
+                if (primary != failure) primary.addSuppressed(failure);
+            }
+            else throw failure;
+        }
+    }
+    private synchronized void advanceOwnedGeneration() {
+        if (!isOwnedStrict()) return;
+        if (ownedGeneration == Long.MAX_VALUE) throw ownedFailure("Owned generation overflow");
+        ++ownedGeneration;
+    }
+    final void acquireOwnedUnchecked() {
+        try { acquireOwned(TaskMonitor.DUMMY); }
+        catch (CancelledException e) { throw ownedFailure(e); }
+    }
+    private void ownedIngress(DataType input) {
+        if (!isOwnedStrict()) return;
+        requireOwnedLive();
+        if (input == null) throw ownedFailure("Null non-edge input");
+        if (input instanceof Pointer p) checkOwnedPointerCopy(p, this);
+    }
+    /** Negative-only cross-package ingress hook. Cannot grant authority or clear a receipt. */
+    public static void recordOwnedPointerFailure(DataTypeManager destination, Throwable cause) {
+        if (destination instanceof DataTypeManagerDB manager && manager.isOwnedStrict())
+            manager.ownedFailure(cause);
+    }
+    public static void checkOwnedPointerCopy(Pointer source, DataTypeManager destination) {
+        if (!(destination instanceof DataTypeManagerDB manager) || !manager.isOwnedStrict()) return;
+        manager.requireOwnedLive();
+        try {
+            // Check exact DB class and its field owner BEFORE ANY virtual getters or cloning.
+            if (source != null && source.getClass() == PointerDB.class) {
+                PointerDB pointer = (PointerDB) source;
+                if (pointer.dataMgr != manager) throw manager.ownedFailure("Foreign DB pointer ingress");
+                manager.acquireOwned(TaskMonitor.DUMMY);
+                try { manager.readOwnedPointerEdge(pointer, TaskMonitor.DUMMY); }
+                finally { manager.lock.release(); }
+            }
+            else if (source instanceof PointerDataType pointer) {
+                pointer.strictReferencedDataType(manager);
+            }
+            else throw manager.ownedFailure("Unknown pointer ingress");
+        }
+        catch (IOException | CancelledException | RuntimeException | Error e) {
+            throw manager.ownedFailure(e);
+        }
+    }
+    final long readOwnedPointerEdge(PointerDB selected, TaskMonitor monitor)
+            throws IOException, CancelledException {
+        requireOwnedLive();
+        try {
+            checkOwnedCancellation(monitor);
+            if (lock.getOwner() != Thread.currentThread() || selected == null ||
+                selected.getClass() != PointerDB.class || selected.dataMgr != this)
+                throw ownedFailure("Pointer owner/lock mismatch");
+            // No dtCache.get/contains/getID before the cached/current row comparison.
+            long edge = selected.readOwnedEdgeChecked(monitor);
+            if (!dtCache.isCachedIdentity(selected.getKey(), selected))
+                throw ownedFailure("Pointer cache identity mismatch");
+            if (edge != NULL_DATATYPE_ID) {
+                DataType child = getDataType(edge);
+                requireOwnedChildIdentity(child, edge);
+            }
+            checkOwnedCancellation(monitor);
+            return edge;
+        }
+        catch (IOException | CancelledException | RuntimeException | Error e) {
+            ownedFailure(e); throw e;
+        }
+    }
+    private void requireOwnedChildIdentity(DataType child, long id) throws IOException {
+        if (id == DEFAULT_DATATYPE_ID) {
+            if (child != DataType.DEFAULT) throw ownedFailure("DEFAULT identity mismatch");
+            return;
+        }
+        if (id == BAD_DATATYPE_ID) {
+            if (child != BadDataType.dataType) throw ownedFailure("BAD identity mismatch");
+            return;
+        }
+        if (child == null || id == NULL_DATATYPE_ID || child.getDataTypeManager() != this)
+            throw ownedFailure("Missing/unowned child");
+        if (child instanceof DataTypeDB db) {
+            DBRecord live = switch (getTableID(id)) {
+                case POINTER -> pointerAdapter.getRecord(id);
+                case ARRAY -> arrayAdapter.getRecord(id);
+                case COMPOSITE -> compositeAdapter.getRecord(id);
+                case TYPEDEF -> typedefAdapter.getRecord(id);
+                case FUNCTION_DEF -> functionDefAdapter.getRecord(id);
+                case ENUM -> enumAdapter.getRecord(id);
+                default -> null;
+            };
+            if (live == null || live.getKey() != id || !live.hasSameSchema(db.record) ||
+                !dtCache.isCachedIdentity(id, db) || db.isDeleted() || getDataType(id) != child)
+                throw ownedFailure("Child row identity mismatch");
+        }
+        else if (builtInMap.get(id) != child || !Long.valueOf(id).equals(builtIn2IdMap.get(child)) ||
