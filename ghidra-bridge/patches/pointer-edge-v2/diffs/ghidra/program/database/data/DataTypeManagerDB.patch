+            requireOwnedLive(); checkOwnedCancellation(monitor);
+            RecordIterator iterator = settingsAdapter.getRecords(typeID, typeID);
+            checkOwnedCancellation(monitor);
+            if (!iterator.hasNext()) return true;
+            checkOwnedCancellation(monitor);
