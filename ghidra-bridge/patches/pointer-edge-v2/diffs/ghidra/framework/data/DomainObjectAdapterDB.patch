+
+
+    private final java.util.concurrent.atomic.AtomicReference<OwnedProgramIntegrityException>
+        ownedIntegrityFailure = new java.util.concurrent.atomic.AtomicReference<>();
+
+    /** Error-only receipt; deliberately independent of DB and consumer lifetime. */
+    public final OwnedProgramIntegrityException recordOwnedIntegrityFailure(Throwable cause) {
+        if (cause == null) cause = new IllegalArgumentException("Missing owned failure cause");
+        OwnedProgramIntegrityException failure = cause instanceof OwnedProgramIntegrityException
+            ? (OwnedProgramIntegrityException) cause : new OwnedProgramIntegrityException(cause);
+        ownedIntegrityFailure.compareAndSet(null, failure);
+        return ownedIntegrityFailure.get();
+    }
+
+    public final void checkOwnedIntegrity() {
+        OwnedProgramIntegrityException failure = ownedIntegrityFailure.get();
+        if (failure != null) throw failure;
+    }
