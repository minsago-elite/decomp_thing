{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/minsago-elite/decomp_thing/oracle/llvm/source-lock.schema.json",
  "title": "LLVM/Clang oracle source provenance lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "oracle", "source", "revision", "signing", "redistribution"],
  "properties": {
    "schemaVersion": {"const": 1},
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "project", "purpose", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^clang-driver-[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "project": {"const": "LLVM Project"},
        "purpose": {"type": "string", "minLength": 1},
        "version": {"$ref": "#/$defs/version"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archiveRoot", "releasePageUrl", "archive", "detachedSignature"],
      "properties": {
        "archiveRoot": {"type": "string", "minLength": 1},
        "releasePageUrl": {"$ref": "#/$defs/httpsUrl"},
        "archive": {"$ref": "#/$defs/download"},
        "detachedSignature": {"$ref": "#/$defs/download"}
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryUrl", "tag", "tagObject", "commit", "tagEvidence", "archiveMarkers"],
      "properties": {
        "repositoryUrl": {"const": "https://github.com/llvm/llvm-project.git"},
        "tag": {"type": "string", "pattern": "^llvmorg-[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "tagObject": {"$ref": "#/$defs/gitObject"},
        "commit": {"$ref": "#/$defs/gitObject"},
        "tagEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["payloadFile", "payloadBytes", "payloadSha256", "signatureFile", "signatureBytes", "signatureSha256"],
          "properties": {
            "payloadFile": {"$ref": "#/$defs/relativePath"},
            "payloadBytes": {"type": "integer", "minimum": 1},
            "payloadSha256": {"$ref": "#/$defs/sha256"},
            "signatureFile": {"$ref": "#/$defs/relativePath"},
            "signatureBytes": {"type": "integer", "minimum": 1},
            "signatureSha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "archiveMarkers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version"],
          "properties": {"version": {"$ref": "#/$defs/textRecord"}}
        }
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityUrl", "keyRetrievalUrl", "keyFile", "keySha256", "primaryFingerprint", "signingFingerprint"],
      "properties": {
        "authorityUrl": {"const": "https://releases.llvm.org/release-keys.asc"},
        "keyRetrievalUrl": {"const": "https://releases.llvm.org/release-keys.asc"},
        "keyFile": {"$ref": "#/$defs/relativePath"},
        "keySha256": {"$ref": "#/$defs/sha256"},
        "primaryFingerprint": {"$ref": "#/$defs/fingerprint"},
        "signingFingerprint": {"$ref": "#/$defs/fingerprint"}
      }
    },
    "redistribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "licenseFiles"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "licenseFiles": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/descriptionRecord"}
        }
      }
    }
  },
  "$defs": {
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitObject": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "fingerprint": {"type": "string", "pattern": "^[0-9A-F]{40}$"},
    "httpsUrl": {"type": "string", "pattern": "^https://[^?#\\s]+$"},
    "relativePath": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\\\u0000]+$"},
    "download": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "url", "bytes", "sha256"],
      "properties": {
        "fileName": {"type": "string", "pattern": "^[^/\\\\\\u0000]+$"},
        "url": {"$ref": "#/$defs/httpsUrl"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "textRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "text"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "text": {"type": "string"}
      }
    },
    "descriptionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "description"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "description": {"type": "string", "minLength": 1}
      }
    }
  }
}
