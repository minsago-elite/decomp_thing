{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/minsago-elite/decomp_thing/oracle/full-tree-scope.schema.json",
  "title": "Source-aligned full-tree oracle scope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "oracle", "pathPolicy", "sharding", "populations", "bounds"],
  "properties": {
    "schemaVersion": {"const": 1},
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceLockSha256", "artifactManifestSha256", "richArtifactSha256", "strippedArtifactSha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "sourceLockSha256": {"$ref": "#/$defs/sha256"},
        "artifactManifestSha256": {"$ref": "#/$defs/sha256"},
        "richArtifactSha256": {"$ref": "#/$defs/sha256"},
        "strippedArtifactSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "pathPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prefixMaps"],
      "properties": {
        "prefixMaps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": {"type": "string", "pattern": "^/[^\\u0000]+/$"},
              "to": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*/$"}
            }
          }
        }
      }
    },
    "sharding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules", "mergeOrdering", "duplicateOwnership"],
      "properties": {
        "rules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pathPrefix", "componentDepth", "shardPrefix"],
            "properties": {
              "pathPrefix": {"type": "string", "pattern": "^[a-z][^\\u0000]*/$"},
              "componentDepth": {"type": "integer", "minimum": 0, "maximum": 8},
              "shardPrefix": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}
            }
          }
        },
        "mergeOrdering": {"const": "shard-id,source-path,unit-id,entity-kind,entity-id"},
        "duplicateOwnership": {"const": "lowest-source-aligned-unit-id; aliases remain evidence on one emitted RVA"}
      }
    },
    "populations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scored", "unobservable", "excluded", "exclusions"],
      "properties": {
        "scored": {"const": "emitted ELF entities with independently source-aligned DWARF ownership"},
        "unobservable": {"const": "authenticated source or DWARF entities without an emitted address"},
        "excluded": {"const": "entities matching one reviewed exclusion record and no scored record"},
        "exclusions": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "reasonCode", "detail"],
            "properties": {
              "path": {"type": "string", "minLength": 1, "maxLength": 4096},
              "reasonCode": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
              "detail": {"type": "string", "minLength": 1, "maxLength": 4096}
            }
          }
        }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["perShard", "wholeRun"],
      "properties": {
        "perShard": {"$ref": "#/$defs/bounds"},
        "wholeRun": {"$ref": "#/$defs/bounds"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compilationUnits", "cpuSeconds", "entities", "serializedBytes", "wallClockSeconds", "maximumResidentBytes"],
      "properties": {
        "compilationUnits": {"type": "integer", "minimum": 1},
        "cpuSeconds": {"type": "integer", "minimum": 1},
        "entities": {"type": "integer", "minimum": 1},
        "serializedBytes": {"type": "integer", "minimum": 1},
        "wallClockSeconds": {"type": "integer", "minimum": 1},
        "maximumResidentBytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
