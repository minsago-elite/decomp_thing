{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/minsago-elite/decomp_thing/oracle/llvm-behavior-candidate-observations.schema.json",
  "title": "Caller-supplied LLVM candidate behavior observations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reference", "candidateExecutable", "cases"],
  "properties": {
    "schemaVersion": {"const": 1},
    "reference": {"$ref": "#/$defs/reference"},
    "candidateExecutable": {"$ref": "#/$defs/executable"},
    "cases": {
      "type": "array",
      "minItems": 48,
      "maxItems": 48,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/observedCase"},
          {"$ref": "#/$defs/notRunCase"},
          {"$ref": "#/$defs/infrastructureFailedCase"}
        ]
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 128},
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)[^/]+(?:/[^/]+)*$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpusId", "corpusSha256", "reportSha256", "diagnosticMatrixSha256", "diagnosticMatrixSelfSha256", "artifactManifestSha256", "sandboxSha256"],
      "properties": {
        "corpusId": {"$ref": "#/$defs/id"},
        "corpusSha256": {"$ref": "#/$defs/sha256"},
        "reportSha256": {"$ref": "#/$defs/sha256"},
        "diagnosticMatrixSha256": {"$ref": "#/$defs/sha256"},
        "diagnosticMatrixSelfSha256": {"$ref": "#/$defs/sha256"},
        "artifactManifestSha256": {"$ref": "#/$defs/sha256"},
        "sandboxSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "executable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "sha256"],
      "properties": {
        "bytes": {"type": "integer", "minimum": 1, "maximum": 134217728},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "blob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "sha256", "base64"],
      "properties": {
        "bytes": {"type": "integer", "minimum": 0, "maximum": 16777216},
        "sha256": {"$ref": "#/$defs/sha256"},
        "base64": {"type": "string", "maxLength": 22369624, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"}
      }
    },
    "artifact": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "present", "bytes", "sha256", "base64", "mode"],
          "properties": {
            "path": {"$ref": "#/$defs/path"},
            "present": {"const": true},
            "bytes": {"type": "integer", "minimum": 0, "maximum": 16777216},
            "sha256": {"$ref": "#/$defs/sha256"},
            "base64": {"type": "string", "maxLength": 22369624, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"},
            "mode": {"type": "string", "pattern": "^0o[4-7][0-7]{2}$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "present", "bytes", "sha256", "base64", "mode"],
          "properties": {
            "path": {"$ref": "#/$defs/path"},
            "present": {"const": false},
            "bytes": {"type": "null"},
            "sha256": {"type": "null"},
            "base64": {"type": "null"},
            "mode": {"type": "null"}
          }
        }
      ]
    },
    "observedCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "exitCode", "stdout", "stderr", "artifacts"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "status": {"const": "observed"},
        "exitCode": {"type": "integer", "minimum": 0, "maximum": 255},
        "stdout": {"$ref": "#/$defs/blob"},
        "stderr": {"$ref": "#/$defs/blob"},
        "artifacts": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/artifact"}}
      }
    },
    "notRunCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "failureCode"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "status": {"const": "not-run"},
        "failureCode": {"enum": ["blocked-by-infrastructure-failure", "not-requested"]}
      }
    },
    "infrastructureFailedCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "failureCode"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "status": {"const": "infrastructure-failed"},
        "failureCode": {
          "enum": [
            "candidate-unexecutable",
            "collection-failed",
            "process-launch-failed",
            "resource-limit",
            "runner-failed",
            "sandbox-failed",
            "timeout"
          ]
        }
      }
    }
  }
}
