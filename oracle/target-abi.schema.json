{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/minsago-elite/decomp_thing/oracle/target-abi.schema.json",
  "title": "Generic target ABI descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "target",
    "callingConventions",
    "abiClasses",
    "scalarWidthsBits"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"$ref": "#/$defs/identifier"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture", "endianness", "addressBits", "objectFormat"],
      "properties": {
        "architecture": {"$ref": "#/$defs/identifier"},
        "endianness": {"enum": ["little", "big"]},
        "addressBits": {"type": "integer", "minimum": 8, "maximum": 64},
        "objectFormat": {"$ref": "#/$defs/identifier"}
      }
    },
    "callingConventions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/callingConvention"}
    },
    "abiClasses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "scalarWidthsBits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pointer", "size", "ptrdiff", "boolean"],
      "properties": {
        "pointer": {"$ref": "#/$defs/width"},
        "size": {"$ref": "#/$defs/width"},
        "ptrdiff": {"$ref": "#/$defs/width"},
        "boolean": {"$ref": "#/$defs/width"}
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$"},
    "width": {"type": "integer", "minimum": 1, "maximum": 1024},
    "registers": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "callingConvention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "aliases",
        "integerArgumentRegisters",
        "floatingArgumentRegisters",
        "integerReturnRegisters",
        "floatingReturnRegisters",
        "stackAlignmentBytes",
        "redZoneBytes",
        "variadicRegisterCountRegister"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "aliases": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "integerArgumentRegisters": {"$ref": "#/$defs/registers"},
        "floatingArgumentRegisters": {"$ref": "#/$defs/registers"},
        "integerReturnRegisters": {"$ref": "#/$defs/registers"},
        "floatingReturnRegisters": {"$ref": "#/$defs/registers"},
        "stackAlignmentBytes": {"type": "integer", "minimum": 1, "maximum": 4096},
        "redZoneBytes": {"type": "integer", "minimum": 0, "maximum": 65536},
        "variadicRegisterCountRegister": {
          "oneOf": [
            {"type": "string", "minLength": 1, "maxLength": 128},
            {"type": "null"}
          ]
        }
      }
    }
  }
}
