{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/minsago-elite/decomp_thing/oracle/toolchain-reproduction.schema.json",
  "title": "Oracle toolchain stable reproduction lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordedOrigin", "recipe"],
  "properties": {
    "schemaVersion": {"const": 1},
    "recordedOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["buildRecordSha256", "imageDigest"],
      "properties": {
        "buildRecordSha256": {"$ref": "#/$defs/sha256"},
        "imageDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseImage", "baseImageDigest", "dockerfile", "dockerfileSha256", "platform", "sourceDateEpoch"],
      "properties": {
        "baseImage": {"type": "string", "pattern": "^[a-z0-9]+(?:[._/-][a-z0-9]+)*$"},
        "baseImageDigest": {"$ref": "#/$defs/digest"},
        "dockerfile": {"type": "string", "minLength": 1},
        "dockerfileSha256": {"$ref": "#/$defs/sha256"},
        "platform": {"const": "linux/amd64"},
        "sourceDateEpoch": {"type": "string", "pattern": "^[1-9][0-9]*$"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
