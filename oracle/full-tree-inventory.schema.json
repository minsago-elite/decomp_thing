{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/minsago-elite/decomp_thing/oracle/full-tree-inventory.schema.json",
  "title": "Authenticated full-tree compilation-unit inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "oracle", "counts", "indexSha256", "shards", "units"],
  "properties": {
    "schemaVersion": {"const": 1},
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scopeSha256", "sourceLockSha256", "artifactManifestSha256", "richArtifactSha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "scopeSha256": {"$ref": "#/$defs/sha256"},
        "sourceLockSha256": {"$ref": "#/$defs/sha256"},
        "artifactManifestSha256": {"$ref": "#/$defs/sha256"},
        "richArtifactSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compilationUnits", "generatedUnits", "handwrittenUnits", "shards"],
      "properties": {
        "compilationUnits": {"type": "integer", "minimum": 1},
        "generatedUnits": {"type": "integer", "minimum": 0},
        "handwrittenUnits": {"type": "integer", "minimum": 0},
        "shards": {"type": "integer", "minimum": 1}
      }
    },
    "indexSha256": {"$ref": "#/$defs/sha256"},
    "shards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "unitIds"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "unitIds": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}
        }
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sourcePath", "sourceKind", "shardId", "dwarfOffset", "dwarfVersion", "addressSize", "language", "producerSha256", "rawPathSha256"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "sourcePath": {"type": "string", "pattern": "^(source|generated)/[^\\u0000]+$", "maxLength": 4096},
          "sourceKind": {"enum": ["generated", "handwritten"]},
          "shardId": {"$ref": "#/$defs/id"},
          "dwarfOffset": {"type": "string", "pattern": "^0x[0-9a-f]+$"},
          "dwarfVersion": {"type": "integer", "minimum": 2, "maximum": 5},
          "addressSize": {"type": "integer", "minimum": 1, "maximum": 16},
          "language": {"type": ["integer", "null"], "minimum": 0},
          "producerSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "rawPathSha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,127}$"}
  }
}
