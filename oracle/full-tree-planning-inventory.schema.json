{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/minsago-elite/decomp_thing/oracle/full-tree-planning-inventory.schema.json",
  "title": "Authenticated full-tree planning inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "oracle", "bounds", "counts", "sourceModules", "sourceOnlyUnits", "reportSha256"],
  "properties": {
    "schemaVersion": {"const": 1},
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "configurationSha256", "scopeSha256", "sourceLockSha256", "artifactManifestSha256", "buildRecordSha256", "inventoryArtifactSha256", "inventoryIndexSha256", "sourceInventoryArtifactSha256", "sourceInventoryReportSha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 256},
        "configurationSha256": {"$ref": "#/$defs/sha256"},
        "scopeSha256": {"$ref": "#/$defs/sha256"},
        "sourceLockSha256": {"$ref": "#/$defs/sha256"},
        "artifactManifestSha256": {"$ref": "#/$defs/sha256"},
        "buildRecordSha256": {"$ref": "#/$defs/sha256"},
        "inventoryArtifactSha256": {"$ref": "#/$defs/sha256"},
        "inventoryIndexSha256": {"$ref": "#/$defs/sha256"},
        "sourceInventoryArtifactSha256": {"$ref": "#/$defs/sha256"},
        "sourceInventoryReportSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumCandidateSourceUnits", "maximumOutputRecords", "maximumSerializedBytes", "maximumSourceModules", "maximumWorkUnits"],
      "properties": {
        "maximumCandidateSourceUnits": {"type": "integer", "minimum": 1, "maximum": 200000},
        "maximumOutputRecords": {"type": "integer", "minimum": 1, "maximum": 203000},
        "maximumSerializedBytes": {"type": "integer", "minimum": 1, "maximum": 33554432},
        "maximumSourceModules": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "maximumWorkUnits": {"type": "integer", "minimum": 1, "maximum": 500000}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generatedSourceModules", "handwrittenSourceModules", "sourceModuleShards", "sourceModules", "sourceOnlyShards", "sourceOnlyUnits", "workUnits"],
      "properties": {
        "generatedSourceModules": {"type": "integer", "minimum": 0},
        "handwrittenSourceModules": {"type": "integer", "minimum": 0},
        "sourceModuleShards": {"type": "integer", "minimum": 1},
        "sourceModules": {"type": "integer", "minimum": 1},
        "sourceOnlyShards": {"type": "integer", "minimum": 0},
        "sourceOnlyUnits": {"type": "integer", "minimum": 0},
        "workUnits": {"type": "integer", "minimum": 1}
      }
    },
    "sourceModules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sourceModule"}
    },
    "sourceOnlyUnits": {
      "type": "array",
      "items": {"$ref": "#/$defs/sourceOnlyUnit"}
    },
    "reportSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "compilationUnitId": {"type": "string", "pattern": "^cu-[0-9a-f]{32}$"},
    "shardId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 128},
    "sourcePath": {"type": "string", "pattern": "^(source|generated)/[^\\u0000]+$", "maxLength": 4096},
    "sourceModule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moduleId", "unitId", "shardId", "sourceKind", "sourcePath"],
      "properties": {
        "moduleId": {"$ref": "#/$defs/compilationUnitId"},
        "unitId": {"$ref": "#/$defs/compilationUnitId"},
        "shardId": {"$ref": "#/$defs/shardId"},
        "sourceKind": {"enum": ["generated", "handwritten"]},
        "sourcePath": {"$ref": "#/$defs/sourcePath"}
      }
    },
    "sourceOnlyUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePath", "shardId", "reasonCode"],
      "properties": {
        "sourcePath": {"type": "string", "pattern": "^source/[A-Za-z0-9._+/-]+$", "maxLength": 4096},
        "shardId": {"$ref": "#/$defs/shardId"},
        "reasonCode": {"enum": ["tool-not-linked-into-clang-driver", "target-not-enabled-or-not-linked", "not-selected-by-authenticated-build-graph"]}
      }
    }
  }
}
