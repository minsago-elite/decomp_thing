{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/minsago-elite/decomp_thing/oracle/full-tree-data-baseline.schema.json",
  "title": "Per-shard full-tree data and ABI observability baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "configurationSha256", "dataTruthIndexSha256", "reconciliationReportSha256", "aggregate", "shards", "mismatches", "reportSha256"],
  "properties": {
    "schemaVersion": {"const": 1},
    "configurationSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dataTruthIndexSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reconciliationReportSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "aggregate": {"$ref": "#/$defs/dimensions"},
    "shards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "globals", "types", "abiObjects"],
        "properties": {
          "id": {"type": "string"},
          "globals": {"$ref": "#/$defs/metric"},
          "types": {"$ref": "#/$defs/metric"},
          "abiObjects": {"$ref": "#/$defs/metric"}
        }
      }
    },
    "mismatches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "dimension", "kind", "truthId", "shardId", "reasonCode"],
        "properties": {
          "id": {"type": "string", "pattern": "^(partial|missing)-(global|abi-object)-[0-9a-f]{32}$"},
          "dimension": {"enum": ["globals", "abiObjects"]},
          "kind": {"enum": ["partial", "missing"]},
          "truthId": {"type": "string"},
          "shardId": {"type": "string"},
          "reasonCode": {"type": "string"}
        }
      }
    },
    "reportSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["denominator", "exact", "partial", "missing", "fabricated", "excluded"],
      "properties": {
        "denominator": {"type": "integer", "minimum": 0},
        "exact": {"type": "integer", "minimum": 0},
        "partial": {"type": "integer", "minimum": 0},
        "missing": {"type": "integer", "minimum": 0},
        "fabricated": {"type": "integer", "minimum": 0},
        "excluded": {"type": "integer", "minimum": 0}
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["globals", "types", "abiObjects"],
      "properties": {
        "globals": {"$ref": "#/$defs/metric"},
        "types": {"$ref": "#/$defs/metric"},
        "abiObjects": {"$ref": "#/$defs/metric"}
      }
    }
  }
}
