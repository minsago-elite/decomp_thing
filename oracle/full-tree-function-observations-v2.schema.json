{
  "$id": "https://github.com/minsago-elite/decomp_thing/oracle/full-tree-function-observations-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "counts": {
      "additionalProperties": false,
      "properties": {
        "emittedRvas": {
          "minimum": 0,
          "type": "integer"
        },
        "nonEmitted": {
          "minimum": 0,
          "type": "integer"
        },
        "nonEmittedDies": {
          "minimum": 0,
          "type": "integer"
        },
        "scannedDies": {
          "minimum": 1,
          "type": "integer"
        },
        "units": {
          "minimum": 1,
          "type": "integer"
        },
        "sourceEntities": {
          "minimum": 0,
          "type": "integer"
        },
        "anchorClaims": {
          "minimum": 0,
          "type": "integer"
        },
        "anchorCandidateCount": {
          "minimum": 0,
          "type": "integer"
        },
        "anchorCollisionCandidateCount": {
          "minimum": 0,
          "type": "integer"
        },
        "sourceEntitiesByKind": {
          "$ref": "#/$defs/kindCounts"
        },
        "sourceEntitiesByObservability": {
          "$ref": "#/$defs/observabilityCounts"
        },
        "sourceEntitiesByDenominatorDisposition": {
          "$ref": "#/$defs/dispositionCounts"
        }
      },
      "required": [
        "emittedRvas",
        "nonEmitted",
        "nonEmittedDies",
        "scannedDies",
        "units",
        "anchorClaims",
        "anchorCandidateCount",
        "anchorCollisionCandidateCount",
        "sourceEntities",
        "sourceEntitiesByKind",
        "sourceEntitiesByObservability",
        "sourceEntitiesByDenominatorDisposition"
      ],
      "type": "object"
    },
    "emitted": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "aliases": {
            "items": {
              "$ref": "#/$defs/alias"
            },
            "minItems": 1,
            "type": "array"
          },
          "id": {
            "pattern": "^function-rva-0x(?:0|[1-9a-f][0-9a-f]{0,15})$",
            "type": "string"
          },
          "declarations": {
            "items": {
              "$ref": "#/$defs/declaration"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "ownerUnitIds": {
            "items": {
              "$ref": "#/$defs/unitId"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "rva": {
            "$ref": "#/$defs/address"
          }
        },
        "required": [
          "aliases",
          "declarations",
          "id",
          "ownerUnitIds",
          "rva"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "nonEmitted": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "aliases": {
            "items": {
              "$ref": "#/$defs/alias"
            },
            "minItems": 1,
            "type": "array"
          },
          "dieOffsets": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unitId",
                "dieOffset"
              ],
              "properties": {
                "unitId": {
                  "$ref": "#/$defs/unitId"
                },
                "dieOffset": {
                  "$ref": "#/$defs/address"
                }
              }
            }
          },
          "declaration": {
            "$ref": "#/$defs/declaration"
          },
          "id": {
            "pattern": "^non-emitted-observation-[0-9a-f]{32}$",
            "type": "string"
          },
          "reasonCodes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "enum": [
                "inline-no-emitted-range",
                "definition-no-emitted-range"
              ]
            }
          },
          "unitIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/unitId"
            }
          }
        },
        "required": [
          "aliases",
          "declaration",
          "dieOffsets",
          "id",
          "reasonCodes",
          "unitIds"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "oracle": {
      "additionalProperties": false,
      "properties": {
        "configurationSha256": {
          "$ref": "#/$defs/sha256"
        },
        "inventoryIndexSha256": {
          "$ref": "#/$defs/sha256"
        },
        "richArtifactSha256": {
          "$ref": "#/$defs/sha256"
        },
        "scopeSha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "configurationSha256",
        "inventoryIndexSha256",
        "richArtifactSha256",
        "scopeSha256"
      ],
      "type": "object"
    },
    "schemaVersion": {
      "const": 2
    },
    "shard": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "inputSha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "id",
        "inputSha256"
      ],
      "type": "object"
    },
    "sourceEntities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceEntity"
      },
      "maxItems": 5000000
    },
    "identityReconciliation": {
      "$ref": "#/$defs/identityReconciliation"
    }
  },
  "required": [
    "counts",
    "emitted",
    "nonEmitted",
    "oracle",
    "schemaVersion",
    "shard",
    "identityReconciliation",
    "sourceEntities"
  ],
  "title": "Full-tree DWARF function observation shard with source-entity census",
  "type": "object",
  "$defs": {
    "address": {
      "pattern": "^0x(?:0|[1-9a-f][0-9a-f]{0,15})$",
      "type": "string"
    },
    "alias": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "dwarf-subprogram"
              },
              "locator": {
                "maxLength": 16384,
                "minLength": 1,
                "type": "string"
              },
              "unitId": {
                "$ref": "#/$defs/unitId"
              }
            },
            "required": [
              "kind",
              "locator",
              "unitId"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "name": {
          "maxLength": 16384,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "evidence",
        "name"
      ],
      "type": "object"
    },
    "declaration": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "oneOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "externalPathSha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "fileIndex": {
          "oneOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "line": {
          "oneOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourcePath": {
          "oneOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "unitSourcePath": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "column",
        "externalPathSha256",
        "fileIndex",
        "line",
        "sourcePath",
        "unitSourcePath"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "unitId": {
      "pattern": "^cu-[0-9a-f]{32}$",
      "type": "string"
    },
    "physicalDie": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compilationUnitOffset",
        "dieOffset",
        "locator",
        "richArtifactSha256",
        "section",
        "unitId"
      ],
      "properties": {
        "compilationUnitOffset": {
          "pattern": "^0x(?:0|[1-9a-f][0-9a-f]*)$",
          "type": "string"
        },
        "dieOffset": {
          "pattern": "^0x(?:0|[1-9a-f][0-9a-f]*)$",
          "type": "string"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "richArtifactSha256": {
          "$ref": "#/$defs/sha256"
        },
        "section": {
          "const": ".debug_info"
        },
        "unitId": {
          "$ref": "#/$defs/unitId"
        }
      }
    },
    "anchorFields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authenticatedSourceFileSha256",
        "authenticatedSourceRevision",
        "declarationColumn",
        "declarationFileIndex",
        "declarationLine",
        "inlineCallColumn",
        "inlineCallFile",
        "inlineCallLine",
        "inlineCalleeAnchorCandidateId",
        "inlineOwnerAnchorCandidateId",
        "inlinePathAnchorCandidateIds",
        "language",
        "lexicalContext",
        "signature",
        "sourceName",
        "sourcePath",
        "templateActualArguments",
        "templateFormalParameters",
        "templatePatternAnchorCandidateId"
      ],
      "properties": {
        "authenticatedSourceFileSha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "authenticatedSourceRevision": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            {
              "type": "null"
            }
          ]
        },
        "declarationColumn": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "declarationFileIndex": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "declarationLine": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "inlineCallColumn": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "inlineCallFile": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            {
              "type": "null"
            }
          ]
        },
        "inlineCallLine": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "inlineCalleeAnchorCandidateId": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "inlineOwnerAnchorCandidateId": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "inlinePathAnchorCandidateIds": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/sha256"
              },
              "maxItems": 32
            },
            {
              "type": "null"
            }
          ]
        },
        "language": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "lexicalContext": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "maxItems": 256
        },
        "signature": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "maxItems": 1025
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceName": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            {
              "type": "null"
            }
          ]
        },
        "sourcePath": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "templateActualArguments": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "maxItems": 1025
            },
            {
              "type": "null"
            }
          ]
        },
        "templateFormalParameters": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "maxItems": 1025
            },
            {
              "type": "null"
            }
          ]
        },
        "templatePatternAnchorCandidateId": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "rawReference",
        "reasonCode",
        "referenceForm",
        "source",
        "state",
        "target"
      ],
      "properties": {
        "kind": {
          "enum": [
            "specification",
            "abstract-origin",
            "type",
            "template-formal",
            "template-argument",
            "inline-owner"
          ]
        },
        "rawReference": {
          "oneOf": [
            {
              "pattern": "^0x(?:0|[1-9a-f][0-9a-f]*)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasonCode": {
          "oneOf": [
            {
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
              "type": "string",
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "referenceForm": {
          "oneOf": [
            {
              "pattern": "^0x[0-9a-f]+$",
              "type": "string",
              "maxLength": 16
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "state": {
          "enum": [
            "resolved",
            "missing-target",
            "malformed",
            "unsupported",
            "cyclic"
          ]
        },
        "target": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "sourceEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateCollisionSourceEntityIds",
        "denominatorDisposition",
        "edges",
        "entityKind",
        "identityObservability",
        "linkedEmittedRva",
        "physicalDie",
        "reasonCodes",
        "resolvedSemanticIdentityId",
        "semanticAnchorCandidateId",
        "semanticAnchorFields",
        "sourceEntityId"
      ],
      "properties": {
        "candidateCollisionSourceEntityIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sha256"
          },
          "uniqueItems": true,
          "maxItems": 2500000
        },
        "denominatorDisposition": {
          "enum": [
            "non-scoreable",
            "emitted-rva-link",
            "unknown",
            "ambiguous"
          ]
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          },
          "maxItems": 32
        },
        "entityKind": {
          "enum": [
            "declaration-only",
            "no-range-definition",
            "template-pattern",
            "template-instance",
            "inline-instance",
            "unresolved"
          ]
        },
        "identityObservability": {
          "enum": [
            "observable",
            "unobservable",
            "unknown",
            "ambiguous"
          ]
        },
        "linkedEmittedRva": {
          "oneOf": [
            {
              "$ref": "#/$defs/address"
            },
            {
              "type": "null"
            }
          ]
        },
        "physicalDie": {
          "$ref": "#/$defs/physicalDie"
        },
        "reasonCodes": {
          "type": "array",
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "type": "string",
            "maxLength": 256
          },
          "uniqueItems": true,
          "maxItems": 1024
        },
        "resolvedSemanticIdentityId": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "semanticAnchorCandidateId": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "semanticAnchorFields": {
          "oneOf": [
            {
              "$ref": "#/$defs/anchorFields"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceEntityId": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "identityReconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "candidateCount",
        "claimCount",
        "collisionCandidateCount",
        "populationSha256"
      ],
      "properties": {
        "algorithm": {
          "const": "full-run-anchor-claims-v1"
        },
        "candidateCount": {
          "minimum": 0,
          "type": "integer"
        },
        "claimCount": {
          "minimum": 0,
          "type": "integer"
        },
        "collisionCandidateCount": {
          "minimum": 0,
          "type": "integer"
        },
        "populationSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "kindCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declaration-only",
        "inline-instance",
        "no-range-definition",
        "template-instance",
        "template-pattern",
        "unresolved"
      ],
      "properties": {
        "declaration-only": {
          "minimum": 0,
          "type": "integer"
        },
        "inline-instance": {
          "minimum": 0,
          "type": "integer"
        },
        "no-range-definition": {
          "minimum": 0,
          "type": "integer"
        },
        "template-instance": {
          "minimum": 0,
          "type": "integer"
        },
        "template-pattern": {
          "minimum": 0,
          "type": "integer"
        },
        "unresolved": {
          "minimum": 0,
          "type": "integer"
        }
      }
    },
    "observabilityCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ambiguous",
        "observable",
        "unknown",
        "unobservable"
      ],
      "properties": {
        "ambiguous": {
          "minimum": 0,
          "type": "integer"
        },
        "observable": {
          "minimum": 0,
          "type": "integer"
        },
        "unknown": {
          "minimum": 0,
          "type": "integer"
        },
        "unobservable": {
          "minimum": 0,
          "type": "integer"
        }
      }
    },
    "dispositionCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ambiguous",
        "emitted-rva-link",
        "non-scoreable",
        "unknown"
      ],
      "properties": {
        "ambiguous": {
          "minimum": 0,
          "type": "integer"
        },
        "emitted-rva-link": {
          "minimum": 0,
          "type": "integer"
        },
        "non-scoreable": {
          "minimum": 0,
          "type": "integer"
        },
        "unknown": {
          "minimum": 0,
          "type": "integer"
        }
      }
    }
  }
}
