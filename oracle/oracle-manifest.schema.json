{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/minsago-elite/decomp_thing/oracle/oracle-manifest.schema.json",
  "title": "Source-aligned ELF oracle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "oracle", "inputs", "artifacts", "equivalence"],
  "properties": {
    "schemaVersion": {"const": 1},
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sourceRevision"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "sourceRevision": {"$ref": "#/$defs/gitObject"}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceLock", "buildRecord"],
      "properties": {
        "sourceLock": {"$ref": "#/$defs/fileRecord"},
        "buildRecord": {"$ref": "#/$defs/fileRecord"}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full", "stripped"],
      "properties": {
        "full": {"$ref": "#/$defs/artifact"},
        "stripped": {"$ref": "#/$defs/artifact"}
      }
    },
    "equivalence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buildId",
        "elfIdentity",
        "programHeadersSha256",
        "allocatedSectionsSha256",
        "executableLoad",
        "metadataDelta"
      ],
      "properties": {
        "buildId": {"type": "string", "pattern": "^(?:[0-9a-f]{2}){4,64}$"},
        "elfIdentity": {"$ref": "#/$defs/identity"},
        "programHeadersSha256": {"$ref": "#/$defs/sha256"},
        "allocatedSectionsSha256": {"$ref": "#/$defs/sha256"},
        "executableLoad": {"$ref": "#/$defs/executableLoad"},
        "metadataDelta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fullOnlySections",
            "strippedOnlySections",
            "changedCommonSections",
            "removedDwarfSections",
            "removedStaticSymbolTables"
          ],
          "properties": {
            "fullOnlySections": {"$ref": "#/$defs/stringArray"},
            "strippedOnlySections": {"$ref": "#/$defs/stringArray"},
            "changedCommonSections": {"$ref": "#/$defs/stringArray"},
            "removedDwarfSections": {"$ref": "#/$defs/stringArray"},
            "removedStaticSymbolTables": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/symbolTable"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitObject": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\\\u0000]+$"
    },
    "fileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "elf"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "elf": {"$ref": "#/$defs/elf"}
      }
    },
    "elf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "header",
        "identity",
        "buildIds",
        "programHeaders",
        "sections",
        "metadata",
        "executableLoad"
      ],
      "properties": {
        "header": {"$ref": "#/$defs/header"},
        "identity": {"$ref": "#/$defs/identity"},
        "buildIds": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^(?:[0-9a-f]{2}){4,64}$"}
        },
        "programHeaders": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/programHeader"}
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/section"}
        },
        "metadata": {"$ref": "#/$defs/metadata"},
        "executableLoad": {"$ref": "#/$defs/executableLoad"}
      }
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "dataEncoding",
        "identVersion",
        "osAbi",
        "osAbiName",
        "abiVersion",
        "type",
        "typeName",
        "machine",
        "machineName",
        "version",
        "entryPoint",
        "programHeaderOffset",
        "sectionHeaderOffset",
        "flags",
        "headerSize",
        "programHeaderEntrySize",
        "programHeaderCount",
        "sectionHeaderEntrySize",
        "sectionHeaderCount",
        "sectionNameTableIndex"
      ],
      "properties": {
        "class": {"enum": ["ELF32", "ELF64"]},
        "dataEncoding": {"enum": ["little-endian", "big-endian"]},
        "identVersion": {"type": "integer", "minimum": 0},
        "osAbi": {"type": "integer", "minimum": 0},
        "osAbiName": {"type": "string", "minLength": 1},
        "abiVersion": {"type": "integer", "minimum": 0},
        "type": {"type": "integer", "minimum": 0},
        "typeName": {"type": "string", "minLength": 1},
        "machine": {"type": "integer", "minimum": 0},
        "machineName": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 0},
        "entryPoint": {"type": "integer", "minimum": 0},
        "programHeaderOffset": {"type": "integer", "minimum": 0},
        "sectionHeaderOffset": {"type": "integer", "minimum": 0},
        "flags": {"type": "integer", "minimum": 0},
        "headerSize": {"type": "integer", "minimum": 1},
        "programHeaderEntrySize": {"type": "integer", "minimum": 0},
        "programHeaderCount": {"type": "integer", "minimum": 0},
        "sectionHeaderEntrySize": {"type": "integer", "minimum": 1},
        "sectionHeaderCount": {"type": "integer", "minimum": 1},
        "sectionNameTableIndex": {"type": "integer", "minimum": 1}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "dataEncoding",
        "identVersion",
        "osAbi",
        "abiVersion",
        "type",
        "machine",
        "version",
        "entryPoint",
        "flags"
      ],
      "properties": {
        "class": {"enum": ["ELF32", "ELF64"]},
        "dataEncoding": {"enum": ["little-endian", "big-endian"]},
        "identVersion": {"type": "integer", "minimum": 0},
        "osAbi": {"type": "integer", "minimum": 0},
        "abiVersion": {"type": "integer", "minimum": 0},
        "type": {"type": "integer", "minimum": 0},
        "machine": {"type": "integer", "minimum": 0},
        "version": {"type": "integer", "minimum": 0},
        "entryPoint": {"type": "integer", "minimum": 0},
        "flags": {"type": "integer", "minimum": 0}
      }
    },
    "programHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "type",
        "typeName",
        "flags",
        "flagNames",
        "offset",
        "virtualAddress",
        "physicalAddress",
        "fileSize",
        "memorySize",
        "alignment",
        "contentSha256"
      ],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "type": {"type": "integer", "minimum": 0},
        "typeName": {"type": "string", "minLength": 1},
        "flags": {"type": "integer", "minimum": 0},
        "flagNames": {"type": "string", "pattern": "^[R-][W-][E-]$"},
        "offset": {"type": "integer", "minimum": 0},
        "virtualAddress": {"type": "integer", "minimum": 0},
        "physicalAddress": {"type": "integer", "minimum": 0},
        "fileSize": {"type": "integer", "minimum": 0},
        "memorySize": {"type": "integer", "minimum": 0},
        "alignment": {"type": "integer", "minimum": 0},
        "contentSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "name",
        "type",
        "typeName",
        "flags",
        "address",
        "offset",
        "size",
        "link",
        "info",
        "alignment",
        "entrySize",
        "allocated",
        "executable",
        "fileBacked",
        "contentSha256"
      ],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "name": {"type": "string"},
        "type": {"type": "integer", "minimum": 0},
        "typeName": {"type": "string", "minLength": 1},
        "flags": {"type": "integer", "minimum": 0},
        "address": {"type": "integer", "minimum": 0},
        "offset": {"type": "integer", "minimum": 0},
        "size": {"type": "integer", "minimum": 0},
        "link": {"type": "integer", "minimum": 0},
        "info": {"type": "integer", "minimum": 0},
        "alignment": {"type": "integer", "minimum": 0},
        "entrySize": {"type": "integer", "minimum": 0},
        "allocated": {"type": "boolean"},
        "executable": {"type": "boolean"},
        "fileBacked": {"type": "boolean"},
        "contentSha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hasDwarf",
        "dwarfSections",
        "hasStaticSymbols",
        "staticSymbolTables",
        "hasDynamicSymbols",
        "dynamicSymbolTables"
      ],
      "properties": {
        "hasDwarf": {"type": "boolean"},
        "dwarfSections": {"$ref": "#/$defs/stringArray"},
        "hasStaticSymbols": {"type": "boolean"},
        "staticSymbolTables": {
          "type": "array",
          "items": {"$ref": "#/$defs/symbolTable"}
        },
        "hasDynamicSymbols": {"type": "boolean"},
        "dynamicSymbolTables": {
          "type": "array",
          "items": {"$ref": "#/$defs/symbolTable"}
        }
      }
    },
    "symbolTable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section", "entries"],
      "properties": {
        "section": {"type": "string", "minLength": 1},
        "entries": {"type": "integer", "minimum": 0}
      }
    },
    "executableLoad": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "segmentIndexes", "bytes", "sha256"],
      "properties": {
        "selector": {"const": "PT_LOAD with PF_X and nonzero p_filesz"},
        "segmentIndexes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 0}
        },
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "stringArray": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
