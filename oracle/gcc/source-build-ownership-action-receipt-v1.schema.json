            "minLength": 1,
            "pattern": "^(source|generated|build|toolchain|external)(/|$)",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "bytes",
          "sha256",
          "kind"
