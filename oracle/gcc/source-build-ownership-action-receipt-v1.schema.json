      "maxItems": 16384,
      "minItems": 1,
      "type": "array"
    },
    "authority": {
      "additionalProperties": false,
      "properties": {
        "captureAuthenticated": {
          "const": false
        },
        "modelBound": {
          "const": false
        },
        "ownershipComplete": {
          "const": false
        },
        "productionVerified": {
          "const": false
        },
        "releaseEligible": {
          "const": false
        },
        "runtimeAuthenticated": {
          "const": false
        },
        "scored": {
          "const": false
        },
        "sealed": {
          "const": false
        },
        "sourceAuthenticated": {
          "const": false
        }
      },
      "required": [
        "sourceAuthenticated",
        "runtimeAuthenticated",
        "ownershipComplete",
        "modelBound",
        "sealed",
        "scored",
        "productionVerified",
        "releaseEligible",
        "captureAuthenticated"
