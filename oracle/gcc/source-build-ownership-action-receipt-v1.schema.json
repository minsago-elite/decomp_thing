        "maxLength": 65536,
        "type": "string"
      },
      "maxProperties": 4096,
      "propertyNames": {
        "enum": [
          "PATH",
          "LANG",
          "LC_ALL",
          "TZ",
          "SOURCE_DATE_EPOCH",
          "CFLAGS",
          "CXXFLAGS",
          "CPPFLAGS",
          "LDFLAGS"
