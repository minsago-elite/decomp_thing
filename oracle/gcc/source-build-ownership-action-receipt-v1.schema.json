    "profileSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "responseFiles": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "maximum": 4194304,
            "minimum": 0,
            "type": "integer"
          },
          "bytesHex": {
            "$comment": "The typed validator separately checks exact even hex length, byte count, SHA256 and input-file binding.",
