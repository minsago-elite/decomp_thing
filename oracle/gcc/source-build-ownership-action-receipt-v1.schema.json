            "$comment": "Full segment, traversal, byte and control-character checks are performed by the bounded typed validator.",
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^(source|generated|build|toolchain|external)(/|$)",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
