{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/minsago-elite/decomp_thing/oracle/gcc/build-record.schema.json",
  "title": "GCC oracle build record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "oracle",
    "environment",
    "directories",
    "commands",
    "tools",
    "outputs"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [1, 2]
    },
    "buildSystem": {"enum": ["autoconf", "cmake-ninja"]},
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sourceRevision", "sourceLockSha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "sourceRevision": {"$ref": "#/$defs/gitObject"},
        "sourceLockSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["container", "variables"],
      "properties": {
        "container": {
          "type": "object",
          "additionalProperties": false,
          "required": ["image", "digest", "platform"],
          "properties": {
            "image": {"type": "string", "minLength": 1},
            "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "platform": {"const": "linux/amd64"}
          }
        },
        "variables": {
          "type": "object",
          "minProperties": 3,
          "required": ["LC_ALL", "SOURCE_DATE_EPOCH", "TZ"],
          "properties": {
            "LC_ALL": {"const": "C"},
            "SOURCE_DATE_EPOCH": {"type": "string", "pattern": "^[1-9][0-9]*$"},
            "TZ": {"const": "UTC"}
          },
          "patternProperties": {
            "^[A-Z_][A-Z0-9_]*$": {"type": "string"}
          },
          "additionalProperties": false
        }
      }
    },
    "directories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "build", "install"],
      "properties": {
        "source": {"$ref": "#/$defs/absolutePath"},
        "build": {"$ref": "#/$defs/absolutePath"},
        "install": {"$ref": "#/$defs/absolutePath"}
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configure", "compile", "install", "stageFull", "strip"],
      "properties": {
        "configure": {"$ref": "#/$defs/command"},
        "compile": {"$ref": "#/$defs/command"},
        "install": {"$ref": "#/$defs/command"},
        "stageFull": {"$ref": "#/$defs/command"},
        "strip": {"$ref": "#/$defs/command"}
      }
    },
    "tools": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "path",
          "versionCommand",
          "versionOutput",
          "executableBytes",
          "executableSha256"
        ],
        "properties": {
          "role": {"type": "string", "pattern": "^[a-z][A-Za-z0-9]*$"},
          "path": {"$ref": "#/$defs/absolutePath"},
          "versionCommand": {"$ref": "#/$defs/command"},
          "versionOutput": {"type": "string", "minLength": 1},
          "executableBytes": {"type": "integer", "minimum": 1},
          "executableSha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full", "stripped"],
      "properties": {
        "full": {"$ref": "#/$defs/relativePath"},
        "stripped": {"$ref": "#/$defs/relativePath"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schemaVersion": {"const": 2}}},
      "then": {"required": ["buildSystem"]}
    },
    {
      "if": {"properties": {"schemaVersion": {"const": 1}}},
      "then": {"not": {"required": ["buildSystem"]}}
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitObject": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^/(?!$)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\\\u0000]+$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\\\u0000]+$"
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
