{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/minsago-elite/decomp_thing/oracle/full-tree-generated-file-provenance.schema.json",
  "title": "Unreceipted full-tree generated-file snapshot provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "authority", "snapshot", "buildGraph", "files", "actions", "buildGraphProvenanceSha256", "reportSha256"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "full-tree-generated-file-provenance-v1"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "generationReceiptBound", "releaseEligible"],
      "properties": {
        "status": {"const": "unreceipted-generated-snapshot-provenance"},
        "generationReceiptBound": {"const": false},
        "releaseEligible": {"const": false}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archiveRoot", "archiveBytes", "archiveSha256"],
      "properties": {
        "archiveRoot": {"const": "generated"},
        "archiveBytes": {"type": "integer", "minimum": 1, "maximum": 536870912},
        "archiveSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "buildGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["buildRecordSha256", "buildSystem", "buildDirectory", "sourceDateEpoch", "configureCommandSha256", "compileCommandSha256", "cmakeTool", "ninjaTool", "cmakeCacheBytes", "cmakeCacheSha256", "ninjaManifestBytes", "ninjaManifestSha256"],
      "properties": {
        "buildRecordSha256": {"$ref": "#/$defs/sha256"},
        "buildSystem": {"const": "cmake-ninja"},
        "buildDirectory": {"$ref": "#/$defs/absolutePath"},
        "sourceDateEpoch": {"type": "integer", "minimum": 1, "maximum": 8589934591},
        "configureCommandSha256": {"$ref": "#/$defs/sha256"},
        "compileCommandSha256": {"$ref": "#/$defs/sha256"},
        "cmakeTool": {"$ref": "#/$defs/cmakeTool"},
        "ninjaTool": {"$ref": "#/$defs/ninjaTool"},
        "cmakeCacheBytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "cmakeCacheSha256": {"$ref": "#/$defs/sha256"},
        "ninjaManifestBytes": {"type": "integer", "minimum": 1, "maximum": 536870912},
        "ninjaManifestSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60000,
      "items": {"$ref": "#/$defs/file"}
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60000,
      "items": {"$ref": "#/$defs/action"}
    },
    "buildGraphProvenanceSha256": {"$ref": "#/$defs/sha256"},
    "reportSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "absolutePath": {"type": "string", "pattern": "^/(?!$)(?!\\.{1,2}(?:/|$))(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\\\u0000]+$", "maxLength": 4096},
    "generatedPath": {"type": "string", "pattern": "^generated/(?:(?!\\.{1,2}(?:/|$))[A-Za-z0-9._+-]{1,255}/)*(?!\\.{1,2}$)[A-Za-z0-9._+-]{1,255}$", "maxLength": 4096},
    "toolBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "executableBytes", "executableSha256", "versionOutputSha256"],
      "properties": {
        "role": {"enum": ["buildSystem", "buildGenerator"]},
        "path": {"$ref": "#/$defs/absolutePath"},
        "executableBytes": {"type": "integer", "minimum": 1, "maximum": 536870912},
        "executableSha256": {"$ref": "#/$defs/sha256"},
        "versionOutputSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "cmakeTool": {
      "allOf": [
        {"$ref": "#/$defs/toolBinding"},
        {"properties": {"role": {"const": "buildSystem"}}}
      ]
    },
    "ninjaTool": {
      "allOf": [
        {"$ref": "#/$defs/toolBinding"},
        {"properties": {"role": {"const": "buildGenerator"}}}
      ]
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePath", "bytes", "sha256"],
      "properties": {
        "sourcePath": {"$ref": "#/$defs/generatedPath"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 536870912},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputPaths", "producer"],
      "properties": {
        "outputPaths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 60000,
          "items": {"$ref": "#/$defs/generatedPath"}
        },
        "producer": {
          "oneOf": [
            {"$ref": "#/$defs/cmakeProducer"},
            {"$ref": "#/$defs/ninjaProducer"}
          ]
        }
      }
    },
    "cmakeProducer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "runnerIdentitySha256", "generatorIdentitySha256", "generatorCommandSha256", "cmakeOriginSha256", "ninjaDisposition"],
      "properties": {
        "kind": {"const": "cmake-configure"},
        "runnerIdentitySha256": {"$ref": "#/$defs/sha256"},
        "generatorIdentitySha256": {"$ref": "#/$defs/sha256"},
        "generatorCommandSha256": {"$ref": "#/$defs/sha256"},
        "cmakeOriginSha256": {"$ref": "#/$defs/sha256"},
        "ninjaDisposition": {"const": "not-a-ninja-edge"}
      }
    },
    "ninjaProducer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "runnerIdentitySha256", "generatorIdentitySha256", "generatorCommandSha256", "cmakeOriginSha256", "ninjaEdgeSha256"],
      "properties": {
        "kind": {"const": "ninja-edge"},
        "runnerIdentitySha256": {"$ref": "#/$defs/sha256"},
        "generatorIdentitySha256": {"$ref": "#/$defs/sha256"},
        "generatorCommandSha256": {"$ref": "#/$defs/sha256"},
        "cmakeOriginSha256": {"$ref": "#/$defs/sha256"},
        "ninjaEdgeSha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
