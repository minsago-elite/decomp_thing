{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/minsago-elite/decomp_thing/oracle/confidence-calibration-artifact.schema.json",
  "title": "Authenticated, holdout-checked confidence calibration artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "method", "scope", "distribution", "supportPolicy", "partitions", "bands"],
  "properties": {
    "schemaVersion": {"const": 1},
    "method": {"const": "disjoint-fit-holdout-validation-wilson-95-v1"},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["benchmarkId", "benchmarkRevision", "inputSha256", "targetAbiSha256", "oracleId", "scoreDefinitionSha256", "scoreDimension", "distributionProfileSha256", "distributionEvidenceSha256"],
      "properties": {
        "benchmarkId": {"$ref": "#/$defs/id"},
        "benchmarkRevision": {"type": "string", "minLength": 1, "maxLength": 256},
        "inputSha256": {"$ref": "#/$defs/sha256"},
        "targetAbiSha256": {"$ref": "#/$defs/sha256"},
        "oracleId": {"$ref": "#/$defs/id"},
        "scoreDefinitionSha256": {"$ref": "#/$defs/sha256"},
        "scoreDimension": {"$ref": "#/$defs/id"},
        "distributionProfileSha256": {"$ref": "#/$defs/sha256"},
        "distributionEvidenceSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "distribution": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "outOfDistributionAction"],
      "properties": {
        "status": {"enum": ["verified", "unverified"]},
        "outOfDistributionAction": {"const": "uncalibrated"}
      }
    },
    "supportPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["minimumFitSamplesPerBand", "minimumValidationSamplesPerBand", "maximumAbsoluteCalibrationError"],
      "properties": {
        "minimumFitSamplesPerBand": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "minimumValidationSamplesPerBand": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "maximumAbsoluteCalibrationError": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "partitions": {
      "type": "object", "additionalProperties": false,
      "required": ["fit", "validation"],
      "properties": {
        "fit": {"$ref": "#/$defs/partition"},
        "validation": {"$ref": "#/$defs/partition"}
      }
    },
    "bands": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["lowerInclusive", "upperExclusive", "includesUpperBound", "fitSamples", "fitErrors", "fitErrorRate", "validationSamples", "validationErrors", "validationErrorRate"],
        "properties": {
          "lowerInclusive": {"type": "number", "minimum": 0, "maximum": 1},
          "upperExclusive": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
          "includesUpperBound": {"type": "boolean"},
          "fitSamples": {"type": "integer", "minimum": 0, "maximum": 2147483647},
          "fitErrors": {"type": "integer", "minimum": 0, "maximum": 2147483647},
          "fitErrorRate": {"type": "number", "minimum": 0, "maximum": 1},
          "validationSamples": {"type": "integer", "minimum": 0, "maximum": 2147483647},
          "validationErrors": {"type": "integer", "minimum": 0, "maximum": 2147483647},
          "validationErrorRate": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 128},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "partition": {
      "type": "object", "additionalProperties": false,
      "required": ["sha256", "sampleCount"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "sampleCount": {"type": "integer", "minimum": 1, "maximum": 2147483647}
      }
    }
  }
}
