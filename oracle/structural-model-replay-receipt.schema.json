{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/minsago-elite/decomp_thing/oracle/structural-model-replay-receipt.schema.json",
  "title": "Structural recovered-model replay receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "identityReceiptSha256", "identityRequestSha256", "identityObservationSha256", "identityMap", "boundaryReportSha256", "twin", "programModel", "structuralObservation", "recoveredModelId", "recoveredModelPayloadSha256", "provenanceSha256", "receiptSha256"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "structural-model-replay-receipt-v1"},
    "identityReceiptSha256": {"$ref": "#/$defs/sha256"},
    "identityRequestSha256": {"$ref": "#/$defs/sha256"},
    "identityObservationSha256": {"$ref": "#/$defs/sha256"},
    "identityMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256", "bytes", "payloadSha256"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
        "payloadSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "boundaryReportSha256": {"$ref": "#/$defs/sha256"},
    "twin": {"enum": ["rich", "stripped"]},
    "programModel": {"$ref": "#/$defs/artifact"},
    "structuralObservation": {"$ref": "#/$defs/artifact"},
    "recoveredModelId": {"$ref": "#/$defs/identifier"},
    "recoveredModelPayloadSha256": {"$ref": "#/$defs/sha256"},
    "provenanceSha256": {"$ref": "#/$defs/sha256"},
    "receiptSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]*$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 17179869184}
      }
    }
  }
}
