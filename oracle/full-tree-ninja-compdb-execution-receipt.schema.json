  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "absolutePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/(?!\\.{1,2}(?:/|$))(?!.*(?:/\\.{1,2})(?:/|$))[^/\\\\\\u0000\\r\\n]+(?:/[^/\\\\\\u0000\\r\\n]+)*$"
    },
    "compilerRuleName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(C|CXX|ASM)_COMPILER__[A-Za-z0-9_.+-]+_RelWithDebInfo$"
    },
    "environmentVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$",
          "maxLength": 128
        },
        "value": {
          "type": "string",
          "pattern": "^[^\\u0000]*$",
          "maxLength": 1048576
        }
      }
    },
    "runtimeFile": {
