      "properties": {
        "bytes": { "type": "integer", "minimum": 2, "maximum": 67108864 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "canonicalSha256": { "$ref": "#/$defs/sha256" },
        "expectedBytes": { "type": "integer", "minimum": 2, "maximum": 67108864 },
        "expectedSha256": { "$ref": "#/$defs/sha256" },
        "exactMatch": { "const": true },
        "complete": { "const": true },
        "truncated": { "const": false }
      },
      "additionalProperties": false
    },
    "stderrObservation": {
      "type": "object",
      "required": ["bytes", "sha256", "maximumBytes", "complete", "truncated"],
      "properties": {
        "bytes": { "type": "integer", "minimum": 0, "maximum": 8388608 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "maximumBytes": { "type": "integer", "minimum": 1, "maximum": 8388608 },
        "complete": { "const": true },
        "truncated": { "const": false }
      },
      "additionalProperties": false
