{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/minsago-elite/decomp_thing/oracle/full-tree-function-truth.schema.json",
  "title": "Reconciled full-tree function truth shard",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "oracle", "shard", "counts", "functions", "inlineOnly"],
  "properties": {
    "schemaVersion": {"const": 1},
    "oracle": {
      "type": "object", "additionalProperties": false,
      "required": ["scopeSha256", "inventoryIndexSha256", "observationIndexSha256", "elfIndexSha256", "configurationSha256"],
      "properties": {
        "scopeSha256": {"$ref": "#/$defs/sha256"},
        "inventoryIndexSha256": {"$ref": "#/$defs/sha256"},
        "observationIndexSha256": {"$ref": "#/$defs/sha256"},
        "elfIndexSha256": {"$ref": "#/$defs/sha256"},
        "configurationSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "shard": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "unitIds"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "unitIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["functions", "inlineOnly"],
      "properties": {
        "functions": {"type": "integer", "minimum": 0},
        "inlineOnly": {"type": "integer", "minimum": 0}
      }
    },
    "functions": {"type": "array", "items": {"$ref": "#/$defs/function"}},
    "inlineOnly": {"type": "array", "items": {"$ref": "#/$defs/inline"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "minLength": 1, "maxLength": 16384},
    "rva": {"type": "string", "pattern": "^0x(?:0|[1-9a-f][0-9a-f]{0,15})$"},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "locator", "unitId"],
      "properties": {
        "kind": {"enum": ["dwarf-subprogram", "elf-symbol"]},
        "locator": {"type": "string", "minLength": 1, "maxLength": 16384},
        "unitId": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
      }
    },
    "alias": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "evidence"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 16384},
        "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "declaration": {
      "type": "object", "additionalProperties": true,
      "required": ["sourcePath", "externalPathSha256", "line", "column", "fileIndex", "unitSourcePath"]
    },
    "function": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "rva", "population", "reasonCode", "entityKind", "ownerUnitId", "ownershipCandidates", "aliases", "declarations"],
      "properties": {
        "id": {"type": "string", "pattern": "^function-rva-0x(?:0|[1-9a-f][0-9a-f]{0,15})$"},
        "rva": {"$ref": "#/$defs/rva"},
        "population": {"enum": ["scored", "excluded"]},
        "reasonCode": {"oneOf": [{"enum": ["dwarf-rva-without-elf-function"]}, {"type": "null"}]},
        "entityKind": {"enum": ["function", "thunk"]},
        "ownerUnitId": {"$ref": "#/$defs/id"},
        "ownershipCandidates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "aliases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/alias"}},
        "declarations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/declaration"}}
      }
    },
    "inline": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "population", "reasonCode", "ownerUnitId", "observationIds", "aliases", "declarations"],
      "properties": {
        "id": {"type": "string", "pattern": "^inline-declaration-[0-9a-f]{32}$"},
        "population": {"const": "unobservable"},
        "reasonCode": {"const": "inline-no-emitted-range"},
        "ownerUnitId": {"$ref": "#/$defs/id"},
        "observationIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "aliases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/alias"}},
        "declarations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/declaration"}}
      }
    }
  }
}
