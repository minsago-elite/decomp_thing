{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/minsago-elite/decomp_thing/oracle/llvm-behavior-runtime-preflight.schema.json",
  "title": "LLVM live runtime identity and capability preflight",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "authority",
    "candidate",
    "controlClient",
    "corpus",
    "dockerConfig",
    "runtimeEndpoint",
    "queries",
    "runtime",
    "referenceAuthentication",
    "oracleExpectationsExposed",
    "executionClaimed",
    "scoringAuthority",
    "releaseEligible",
    "publication"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "llvm-behavior-runtime-preflight"},
    "authority": {"const": "kotlin-host-live-runtime-preflight-v1"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started", "executed"],
      "properties": {
        "started": {"const": false},
        "executed": {"const": false}
      }
    },
    "controlClient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "sha256", "versionSha256", "identitySha256", "executedFromPinnedDescriptor"],
      "properties": {
        "bytes": {"type": "integer", "minimum": 1, "maximum": 134217728},
        "sha256": {"$ref": "#/$defs/sha256"},
        "versionSha256": {"$ref": "#/$defs/sha256"},
        "identitySha256": {"$ref": "#/$defs/sha256"},
        "executedFromPinnedDescriptor": {"const": true}
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256", "sandboxSha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 128},
        "sha256": {"$ref": "#/$defs/sha256"},
        "sandboxSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "dockerConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pathSha256", "identitySha256", "mode", "empty"],
      "properties": {
        "pathSha256": {"$ref": "#/$defs/sha256"},
        "identitySha256": {"$ref": "#/$defs/sha256"},
        "mode": {"const": "0o700"},
        "empty": {"const": true}
      }
    },
    "runtimeEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "pathSha256", "identitySha256", "parentIdentitySha256", "mode"],
      "properties": {
        "scheme": {"const": "unix"},
        "pathSha256": {"$ref": "#/$defs/sha256"},
        "identitySha256": {"$ref": "#/$defs/sha256"},
        "parentIdentitySha256": {"$ref": "#/$defs/sha256"},
        "mode": {"type": "string", "pattern": "^0o[0-7]{3}$"}
      }
    },
    "queries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commandCount", "timeoutMilliseconds", "maximumStdoutBytes", "maximumStderrBytes", "transcript"],
      "properties": {
        "commandCount": {"const": 4},
        "timeoutMilliseconds": {"type": "integer", "minimum": 1, "maximum": 30000},
        "maximumStdoutBytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "maximumStderrBytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "transcript": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {"$ref": "#/$defs/clientVersionQuery"},
            {"$ref": "#/$defs/engineIdentityQuery"},
            {"$ref": "#/$defs/securityCapabilitiesQuery"},
            {"$ref": "#/$defs/imageIdentityQuery"}
          ],
          "items": false
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend", "resourcePolicyVersion", "product", "serverVersion", "serverCommit", "apiVersion",
        "operatingSystem", "architecture", "kernelVersion", "componentsSha256", "cgroupVersion",
        "cgroupDriver", "storageDriver", "securityOptions", "containerRuntime", "containerRuntimePath",
        "containerRuntimeVersion", "containerRuntimeCommit", "containerRuntimeFeaturesSha256", "volumePlugin",
        "engineProfileSha256", "imageDigest", "platform", "imageEnvironmentSha256",
        "liveRuntimeIdentityVerified", "containmentCapabilitiesVerified", "imageVerified", "liveContainmentVerified"
      ],
      "properties": {
        "backend": {"const": "oci-container-v1"},
        "resourcePolicyVersion": {"const": 1},
        "product": {"$ref": "#/$defs/nonemptyText"},
        "serverVersion": {"$ref": "#/$defs/nonemptyText"},
        "serverCommit": {"$ref": "#/$defs/nonemptyText"},
        "apiVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$", "maxLength": 16},
        "operatingSystem": {"const": "linux"},
        "architecture": {"$ref": "#/$defs/nonemptyText"},
        "kernelVersion": {"$ref": "#/$defs/nonemptyText"},
        "componentsSha256": {"$ref": "#/$defs/sha256"},
        "cgroupVersion": {"const": 2},
        "cgroupDriver": {"$ref": "#/$defs/nonemptyText"},
        "storageDriver": {"$ref": "#/$defs/nonemptyText"},
        "securityOptions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonemptyText"}
        },
        "containerRuntime": {"$ref": "#/$defs/nonemptyText"},
        "containerRuntimePath": {"$ref": "#/$defs/nonemptyText"},
        "containerRuntimeVersion": {"$ref": "#/$defs/nonemptyText"},
        "containerRuntimeCommit": {"$ref": "#/$defs/nonemptyText"},
        "containerRuntimeFeaturesSha256": {"$ref": "#/$defs/sha256"},
        "volumePlugin": {"const": "local"},
        "engineProfileSha256": {"$ref": "#/$defs/sha256"},
        "imageDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "platform": {"type": "string", "pattern": "^[a-z0-9]+/[a-z0-9_]+$", "maxLength": 64},
        "imageEnvironmentSha256": {"$ref": "#/$defs/sha256"},
        "liveRuntimeIdentityVerified": {"const": true},
        "containmentCapabilitiesVerified": {"const": true},
        "imageVerified": {"const": true},
        "liveContainmentVerified": {"const": false}
      }
    },
    "referenceAuthentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["referenceReportSha256", "diagnosticMatrixSha256", "diagnosticMatrixSelfSha256", "artifactManifestSha256"],
      "properties": {
        "referenceReportSha256": {"$ref": "#/$defs/sha256"},
        "diagnosticMatrixSha256": {"$ref": "#/$defs/sha256"},
        "diagnosticMatrixSelfSha256": {"$ref": "#/$defs/sha256"},
        "artifactManifestSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "oracleExpectationsExposed": {"const": false},
    "executionClaimed": {"const": false},
    "scoringAuthority": {"const": false},
    "releaseEligible": {"const": false},
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mechanism", "mode"],
      "properties": {
        "mechanism": {"const": "descriptor-bound-no-replace"},
        "mode": {"const": "0o400"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonemptyText": {"type": "string", "minLength": 1, "maxLength": 4096},
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "argumentsSha256", "exitCode", "signal", "stdoutBytes", "stdoutSha256", "stderrBytes", "stderrSha256"],
      "properties": {
        "id": {"type": "string"},
        "argumentsSha256": {"$ref": "#/$defs/sha256"},
        "exitCode": {"const": 0},
        "signal": {"type": "null"},
        "stdoutBytes": {"type": "integer", "minimum": 0, "maximum": 1048576},
        "stdoutSha256": {"$ref": "#/$defs/sha256"},
        "stderrBytes": {"type": "integer", "minimum": 0, "maximum": 1048576},
        "stderrSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "clientVersionQuery": {"allOf": [{"$ref": "#/$defs/query"}, {"properties": {"id": {"const": "client-version"}}}]},
    "engineIdentityQuery": {"allOf": [{"$ref": "#/$defs/query"}, {"properties": {"id": {"const": "engine-identity"}}}]},
    "securityCapabilitiesQuery": {"allOf": [{"$ref": "#/$defs/query"}, {"properties": {"id": {"const": "security-capabilities"}}}]},
    "imageIdentityQuery": {"allOf": [{"$ref": "#/$defs/query"}, {"properties": {"id": {"const": "image-identity"}}}]}
  }
}
