{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/minsago-elite/decomp_thing/oracle/full-tree-implementation-ownership.schema.json",
  "title": "Non-authoritative historical full-tree implementation ownership projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "authority", "oracle", "bounds", "counts", "sourceOnly", "ownerlessExclusions", "dependencies", "modules", "reportSha256"],
  "properties": {
    "schemaVersion": {"const": 1},
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "purpose", "releaseEligible", "historicalFunctionTruthFormat"],
      "properties": {
        "status": {"const": "non-authoritative"},
        "purpose": {"const": "historical-a13-v2-implementation-ownership-planning"},
        "releaseEligible": {"const": false},
        "historicalFunctionTruthFormat": {"const": "inline-only-v1"}
      }
    },
    "oracle": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "scopeSha256", "inventoryIndexSha256", "planningInventoryArtifactSha256", "planningInventoryReportSha256", "planningInventoryConfigurationSha256", "historicalFunctionTruthArtifactSha256", "historicalFunctionTruthIndexSha256", "historicalFunctionTruthConfigurationSha256", "historicalFunctionBaselineArtifactSha256", "historicalFunctionBaselineReportSha256", "historicalFunctionBaselineConfigurationSha256", "configurationSha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 256},
        "scopeSha256": {"$ref": "#/$defs/sha256"},
        "inventoryIndexSha256": {"$ref": "#/$defs/sha256"},
        "planningInventoryArtifactSha256": {"$ref": "#/$defs/sha256"},
        "planningInventoryReportSha256": {"$ref": "#/$defs/sha256"},
        "planningInventoryConfigurationSha256": {"$ref": "#/$defs/sha256"},
        "historicalFunctionTruthArtifactSha256": {"$ref": "#/$defs/sha256"},
        "historicalFunctionTruthIndexSha256": {"$ref": "#/$defs/sha256"},
        "historicalFunctionTruthConfigurationSha256": {"$ref": "#/$defs/sha256"},
        "historicalFunctionBaselineArtifactSha256": {"$ref": "#/$defs/sha256"},
        "historicalFunctionBaselineReportSha256": {"$ref": "#/$defs/sha256"},
        "historicalFunctionBaselineConfigurationSha256": {"$ref": "#/$defs/sha256"},
        "configurationSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "bounds": {
      "type": "object", "additionalProperties": false,
      "required": ["maximumTruthIndexBytes", "maximumBaselineBytes", "maximumTruthShardBytes", "maximumTruthBytes", "maximumTruthShards", "maximumImplementations", "maximumInlineDeclarations", "maximumSourceModules", "maximumWorkUnits", "maximumSerializedBytes"],
      "properties": {
        "maximumTruthIndexBytes": {"const": 1048576},
        "maximumBaselineBytes": {"const": 67108864},
        "maximumTruthShardBytes": {"const": 536870912},
        "maximumTruthBytes": {"const": 3221225472},
        "maximumTruthShards": {"const": 10000},
        "maximumImplementations": {"const": 3000000},
        "maximumInlineDeclarations": {"const": 3000000},
        "maximumSourceModules": {"const": 1000000},
        "maximumWorkUnits": {"const": 10000000},
        "maximumSerializedBytes": {"const": 67108864}
      }
    },
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceModules", "sourceOnlyUnits", "truthShards", "modulesWithImplementations", "emittedImplementations", "scoredImplementations", "recoveredImplementations", "missingImplementations", "ownedExcludedImplementations", "ownerlessExcludedImplementations", "totalExcludedImplementations", "inlineOnlyDeclarations", "fabricatedImplementations", "dependencyEdges", "workUnits"],
      "properties": {
        "sourceModules": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "sourceOnlyUnits": {"type": "integer", "minimum": 0, "maximum": 200000},
        "truthShards": {"type": "integer", "minimum": 1, "maximum": 10000},
        "modulesWithImplementations": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "emittedImplementations": {"type": "integer", "minimum": 0, "maximum": 3000000},
        "scoredImplementations": {"type": "integer", "minimum": 0, "maximum": 3000000},
        "recoveredImplementations": {"type": "integer", "minimum": 0, "maximum": 3000000},
        "missingImplementations": {"type": "integer", "minimum": 0, "maximum": 3000000},
        "ownedExcludedImplementations": {"type": "integer", "minimum": 0, "maximum": 3000000},
        "ownerlessExcludedImplementations": {"type": "integer", "minimum": 0, "maximum": 3000000},
        "totalExcludedImplementations": {"type": "integer", "minimum": 0, "maximum": 3000000},
        "inlineOnlyDeclarations": {"type": "integer", "minimum": 0, "maximum": 3000000},
        "fabricatedImplementations": {"const": 0},
        "dependencyEdges": {"const": 0},
        "workUnits": {"type": "integer", "minimum": 1, "maximum": 10000000}
      }
    },
    "sourceOnly": {
      "type": "object", "additionalProperties": false,
      "required": ["count", "ownershipStatus", "sourcePathsSha256"],
      "properties": {
        "count": {"type": "integer", "minimum": 0, "maximum": 200000},
        "ownershipStatus": {"const": "excluded-non-owning"},
        "sourcePathsSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "ownerlessExclusions": {
      "type": "object", "additionalProperties": false,
      "required": ["count", "reasonCode", "implementationIdsSha256"],
      "properties": {
        "count": {"type": "integer", "minimum": 0, "maximum": 3000000},
        "reasonCode": {"const": "elf-no-source-aligned-dwarf"},
        "implementationIdsSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "dependencies": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "edges"],
      "properties": {
        "status": {"const": "not-inferred-from-historical-function-evidence"},
        "edges": {"type": "array", "maxItems": 0}
      }
    },
    "modules": {
      "type": "array", "minItems": 1, "maxItems": 1000000,
      "items": {"$ref": "#/$defs/module"}
    },
    "reportSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "unitId": {"type": "string", "pattern": "^cu-[0-9a-f]{32}$"},
    "shardId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 128},
    "moduleCounts": {
      "type": "object", "additionalProperties": false,
      "required": ["emittedImplementations", "scoredImplementations", "recoveredImplementations", "missingImplementations", "excludedImplementations", "inlineOnlyDeclarations"],
      "properties": {
        "emittedImplementations": {"type": "integer", "minimum": 0, "maximum": 3000000},
        "scoredImplementations": {"type": "integer", "minimum": 0, "maximum": 3000000},
        "recoveredImplementations": {"type": "integer", "minimum": 0, "maximum": 3000000},
        "missingImplementations": {"type": "integer", "minimum": 0, "maximum": 3000000},
        "excludedImplementations": {"type": "integer", "minimum": 0, "maximum": 3000000},
        "inlineOnlyDeclarations": {"type": "integer", "minimum": 0, "maximum": 3000000}
      }
    },
    "commitments": {
      "type": "object", "additionalProperties": false,
      "required": ["emittedImplementationIdsSha256", "recoveredImplementationIdsSha256", "missingImplementationIdsSha256", "excludedImplementationIdsSha256", "inlineOnlyDeclarationIdsSha256"],
      "properties": {
        "emittedImplementationIdsSha256": {"$ref": "#/$defs/sha256"},
        "recoveredImplementationIdsSha256": {"$ref": "#/$defs/sha256"},
        "missingImplementationIdsSha256": {"$ref": "#/$defs/sha256"},
        "excludedImplementationIdsSha256": {"$ref": "#/$defs/sha256"},
        "inlineOnlyDeclarationIdsSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "module": {
      "type": "object", "additionalProperties": false,
      "required": ["moduleId", "ownerUnitId", "shardId", "sourceKind", "sourcePath", "counts", "commitments"],
      "properties": {
        "moduleId": {"$ref": "#/$defs/unitId"},
        "ownerUnitId": {"$ref": "#/$defs/unitId"},
        "shardId": {"$ref": "#/$defs/shardId"},
        "sourceKind": {"enum": ["generated", "handwritten"]},
        "sourcePath": {"type": "string", "pattern": "^(source|generated)/[^\\u0000]+$", "maxLength": 4096},
        "counts": {"$ref": "#/$defs/moduleCounts"},
        "commitments": {"$ref": "#/$defs/commitments"}
      }
    }
  }
}
