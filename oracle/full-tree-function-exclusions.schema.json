{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/minsago-elite/decomp_thing/oracle/full-tree-function-exclusions.schema.json",
  "title": "Full-tree ELF functions without source-aligned DWARF",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "oracle", "reasonCode", "functions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "oracle": {"type": "object"},
    "reasonCode": {"const": "elf-no-source-aligned-dwarf"},
    "functions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "rva", "reasonCode", "aliases"],
        "properties": {
          "id": {"type": "string", "pattern": "^function-rva-0x(?:0|[1-9a-f][0-9a-f]{0,15})$"},
          "rva": {"type": "string", "pattern": "^0x(?:0|[1-9a-f][0-9a-f]{0,15})$"},
          "reasonCode": {"const": "elf-no-source-aligned-dwarf"},
          "aliases": {"type": "array", "minItems": 1}
        }
      }
    }
  }
}
