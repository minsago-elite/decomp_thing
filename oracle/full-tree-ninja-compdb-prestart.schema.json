    },
    "compilerRuleName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(C|CXX|ASM)_COMPILER__[A-Za-z0-9_.+-]+_RelWithDebInfo$"
    },
    "environmentVariable": {
