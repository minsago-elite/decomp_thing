{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/minsago-elite/decomp_thing/oracle/full-tree-data-truth.schema.json",
  "title": "Canonical full-tree global and aggregate truth",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "oracle", "shard", "counts", "globals", "types"],
  "properties": {
    "schemaVersion": {"const": 1}, "oracle": {"type": "object"}, "shard": {"type": "object"},
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["globals", "types", "unobservableGlobals", "unobservableTypes", "fields", "bases", "enumerators", "resolvedTypeReferences", "unresolvedTypeReferences", "ambiguousTypeReferences", "crossShardTypeReferences"],
      "properties": {
        "globals": {"type": "integer", "minimum": 0}, "types": {"type": "integer", "minimum": 0},
        "unobservableGlobals": {"type": "integer", "minimum": 0}, "unobservableTypes": {"type": "integer", "minimum": 0},
        "fields": {"type": "integer", "minimum": 0}, "bases": {"type": "integer", "minimum": 0}, "enumerators": {"type": "integer", "minimum": 0},
        "resolvedTypeReferences": {"type": "integer", "minimum": 0}, "unresolvedTypeReferences": {"type": "integer", "minimum": 0}, "ambiguousTypeReferences": {"type": "integer", "minimum": 0}, "crossShardTypeReferences": {"type": "integer", "minimum": 0}
      }
    },
    "globals": {"type": "array", "items": {"$ref": "#/$defs/global"}},
    "types": {"type": "array", "items": {"$ref": "#/$defs/type"}}
  },
  "$defs": {
    "type": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "tag", "name", "context", "population", "reasonCode", "ownerUnitId", "observationIds", "declarations", "byteSize", "alignment", "members"],
      "properties": {
        "id": {"type": "string", "pattern": "^type-[0-9a-f]{32}$"}, "tag": {"type": "string"}, "name": {"type": ["string", "null"]},
        "context": {"type": "array", "items": {"type": "string", "maxLength": 16384}},
        "population": {"enum": ["scored", "unobservable"]}, "reasonCode": {"type": ["string", "null"]},
        "ownerUnitId": {"type": "string"}, "observationIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "declarations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object"}},
        "byteSize": {"type": ["integer", "null"]}, "alignment": {"type": ["integer", "null"]},
        "members": {"type": "array", "items": {"type": "object", "required": ["typeReference"], "properties": {"typeReference": {"$ref": "#/$defs/typeReference"}}}}
      }
    },
    "global": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "names", "population", "reasonCode", "ownerUnitId", "observationIds", "declarations", "addressRva", "size", "alignment", "external", "visibility", "tls", "mutability", "typeReference"],
      "properties": {
        "id": {"type": "string", "pattern": "^global-[0-9a-f]{32}$"}, "names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "population": {"enum": ["scored", "unobservable"]}, "reasonCode": {"type": ["string", "null"]},
        "ownerUnitId": {"type": "string"}, "observationIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "declarations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object"}},
        "addressRva": {"type": ["string", "null"]}, "size": {"type": ["integer", "null"]}, "alignment": {"type": ["integer", "null"]},
        "external": {"type": "boolean"}, "visibility": {"type": "string"}, "tls": {"type": "boolean"}, "mutability": {"type": "string"},
        "typeReference": {"$ref": "#/$defs/typeReference"}
      }
    },
    "typeReference": {
      "type": "object", "additionalProperties": false,
      "required": ["candidateTargetCount", "candidateTargets", "candidateTargetsSha256", "evidenceDieOffsetCount", "evidenceDieOffsets", "evidenceDieOffsetsSha256", "modifierTags", "reasonCode", "resolutionCode", "targetOwnerShardId", "targetTypeId"],
      "properties": {
        "candidateTargetCount": {"type": "integer", "minimum": 0},
        "candidateTargets": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["targetOwnerShardId", "targetTypeId"], "properties": {"targetOwnerShardId": {"type": "string"}, "targetTypeId": {"type": "string", "pattern": "^type-[0-9a-f]{32}$"}}}},
        "candidateTargetsSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evidenceDieOffsetCount": {"type": "integer", "minimum": 0},
        "evidenceDieOffsets": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^0x(?:0|[1-9a-f][0-9a-f]{0,15})$"}},
        "evidenceDieOffsetsSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "modifierTags": {"type": "array", "maxItems": 64, "items": {"type": "string", "pattern": "^DW_TAG_"}},
        "reasonCode": {"type": ["string", "null"], "enum": [null, "no-type-attribute", "non-aggregate-terminal-type", "ambiguous-producer-declaration-targets"]},
        "resolutionCode": {"enum": ["unresolved", "unresolved-authenticated-target-set", "exact-dwarf-offset", "odr-member-sole-source-aligned-target"]},
        "targetOwnerShardId": {"type": ["string", "null"]},
        "targetTypeId": {"oneOf": [{"type": "string", "pattern": "^type-[0-9a-f]{32}$"}, {"type": "null"}]}
      }
    }
  }
}
