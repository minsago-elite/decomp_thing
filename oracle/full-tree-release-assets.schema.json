{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/minsago-elite/decomp_thing/oracle/full-tree-release-assets.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "release", "assets"],
  "properties": {
    "schemaVersion": {"const": 1},
    "release": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "tag", "pageUrl"],
      "properties": {
        "repository": {"const": "minsago-elite/decomp_thing-oracle-artifacts"},
        "tag": {"const": "clang-llvm-22.1.6-a13-v2"},
        "pageUrl": {"type": "string", "format": "uri"}
      }
    },
    "assets": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "bytes", "sha256", "url"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "bytes": {"type": "integer", "minimum": 1, "maximum": 2147483648},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "url": {"type": "string", "format": "uri"}
        }
      }
    }
  }
}
