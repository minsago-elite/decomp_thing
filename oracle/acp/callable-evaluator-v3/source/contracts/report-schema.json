                  "launcherPidIdentityVerified",
                  "scopeVerified",
                  "scopeAdmitted",
                  "captureComplete",
                  "waitComplete",
                  "cleanupVerified",
                  "completed",
                  "termination",
                  "stdoutHex",
                  "stderrHex",
                  "timedOut",
                  "outputExceeded",
                  "infrastructureFailure"
