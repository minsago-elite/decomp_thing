                    "type": "boolean"
                  },
                  "launcherPidIdentityVerified": {
                    "type": "boolean"
                  },
                  "scopeVerified": {
                    "type": "boolean"
                  },
                  "scopeAdmitted": {
                    "type": "boolean"
                  },
                  "captureComplete": {
                    "type": "boolean"
                  },
                  "waitComplete": {
                    "type": "boolean"
                  },
                  "cleanupVerified": {
                    "type": "boolean"
                  },
                  "completed": {
                    "type": "boolean"
                  },
                  "termination": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "enum": [
                              "exit",
                              "signal"
                            ]
                          },
                          "value": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 2147483647
                          }
                        },
                        "required": [
                          "kind",
                          "value"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "const": null
                      }
                    ]
                  },
                  "stdoutHex": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^(?:[0-9a-f]{2})*$",
                        "maxLength": 131072
                      },
                      {
                        "const": null
                      }
                    ]
                  },
                  "stderrHex": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^(?:[0-9a-f]{2})*$",
                        "maxLength": 131072
                      },
                      {
                        "const": null
                      }
                    ]
                  },
                  "timedOut": {
                    "type": "boolean"
                  },
                  "outputExceeded": {
                    "type": "boolean"
                  },
                  "infrastructureFailure": {
                    "type": "boolean"
                  }
