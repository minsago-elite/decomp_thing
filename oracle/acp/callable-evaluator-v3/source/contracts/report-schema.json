                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "completed": {
                          "const": true
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "launcherCreated": {
                          "const": true
                        },
                        "launcherPidIdentityVerified": {
                          "const": true
                        },
                        "scopeVerified": {
                          "const": true
                        },
                        "scopeAdmitted": {
                          "const": true
                        },
                        "captureComplete": {
                          "const": true
                        },
                        "waitComplete": {
                          "const": true
                        },
                        "cleanupVerified": {
                          "const": true
