{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "sourceCheckpointSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "initialSha256": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 10000,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "helperCopySha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "helperSchemaSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "helperSchemaVersion": {
      "const": 3
    }
  },
  "required": [
    "schemaVersion",
    "sourceCheckpointSha256",
    "initialSha256",
    "helperCopySha256",
    "helperSchemaSha256",
    "helperSchemaVersion"
  ],
  "additionalProperties": false
}
