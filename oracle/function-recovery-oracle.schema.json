{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/minsago-elite/decomp_thing/oracle/function-recovery-oracle.schema.json",
  "title": "DWARF and symbol function oracle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scope",
    "oracle",
    "artifacts",
    "scoringPolicy",
    "functions"
  ],
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "scope": {"const": "fixture"},
        "oracle": {
          "properties": {
            "artifactManifestSha256": {"type": "null"}
          }
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "scope": {"const": "production"},
        "oracle": {
          "properties": {
            "artifactManifestSha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    }
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "scope": {"enum": ["fixture", "production"]},
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "artifactManifestSha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 4096},
        "source": {"const": "dwarf-and-symbols"},
        "artifactManifestSha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rich", "stripped"],
      "properties": {
        "rich": {"$ref": "#/$defs/artifact"},
        "stripped": {"$ref": "#/$defs/artifact"}
      }
    },
    "scoringPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nearMissBytes"],
      "properties": {
        "nearMissBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      }
    },
    "functions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {"$ref": "#/$defs/function"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "address": {
      "type": "string",
      "pattern": "^0x(?:0|[1-9a-f][0-9a-f]{0,15})$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputSha256", "elfType", "elfImageBase", "executableRvaRanges"],
      "properties": {
        "inputSha256": {"$ref": "#/$defs/sha256"},
        "elfType": {"enum": ["ET_EXEC", "ET_DYN"]},
        "elfImageBase": {"$ref": "#/$defs/address"},
        "executableRvaRanges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {"$ref": "#/$defs/addressRange"}
        }
      }
    },
    "addressRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "endExclusive"],
      "properties": {
        "start": {"$ref": "#/$defs/address"},
        "endExclusive": {"$ref": "#/$defs/address"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator"],
      "properties": {
        "kind": {"enum": ["dwarf-subprogram", "elf-symbol"]},
        "locator": {"type": "string", "minLength": 1, "maxLength": 16384}
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rich", "stripped"],
      "properties": {
        "rich": {
          "enum": ["surviving", "removed", "not-observable"]
        },
        "stripped": {
          "enum": ["surviving", "removed", "not-observable"]
        }
      }
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "evidence", "availability"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 4096},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "availability": {"$ref": "#/$defs/availability"}
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason"],
      "properties": {
        "kind": {"enum": ["compiler-generated", "inlined"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 16384}
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rva",
        "aliases",
        "exclusion"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 4096},
        "rva": {
          "oneOf": [
            {"$ref": "#/$defs/address"},
            {"type": "null"}
          ]
        },
        "aliases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/alias"}
        },
        "exclusion": {
          "oneOf": [
            {"$ref": "#/$defs/exclusion"},
            {"type": "null"}
          ]
        }
      }
    }
  }
}
